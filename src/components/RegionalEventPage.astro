---
// Detail page for a regional (non-Car-Week) event from src/data/events-2026.ts.
//
// Rendered by src/pages/event/[slug].astro, which routes each slug to either
// this or its own Car Week markup. Same shape as the Car Week page — eyebrow
// date, h1, badges, When / Where, official link, related events — against the
// facts this dataset actually has: county, city, venue, category, date range.
//
// The three events with no confirmed date render "Date not yet announced" and
// emit no Event JSON-LD, because schema.org/Event requires startDate.
import BaseLayout from "../layouts/BaseLayout.astro";
import FireAlert from "./FireAlert.astro";
import {
  DATE_TBA,
  eventHref,
  eventsInMonth,
  monthHref,
  monthMeta,
  primaryMonth,
  type RegionalEvent,
} from "../data/events-2026";
import { buildFaqJsonLd, buildRegionalEventJsonLd } from "../lib/regionalEventSchema";
import { isPastDate } from "../lib/isPast";

const { event } = Astro.props as { event: RegionalEvent };

const site = "https://montereybayevents.com";
const month = monthMeta(primaryMonth(event));
const dateLabel = event.dateText || DATE_TBA;
// Build-time, not view-time — see src/lib/isPast.ts.
const isPast = isPastDate(event.start, event.end);
// Car Week 2026 ran 7–16 August; the footer promo is written in both tenses.
const carWeekIsPast = isPastDate("2026-08-07", "2026-08-16");

const title = event.seoTitle ?? `${event.name} — ${month.label}`;
const heading = event.headline ?? event.name;
const canonical = `${site}/event/${event.slug}/`;
// Neutral brand card, not the Car Week photograph. These are regional listings
// — a Concours photo on a Watsonville street fair describes the wrong event.
// Rendered from public/og-default.svg; re-render if that file changes.
const image = `${site}/og-default.jpg`;
const fallbackDescription = `${event.name} in ${event.city ?? event.county + " County"}, ${event.county} County — ${dateLabel}.`;
const desc = (event.metaDescription ?? event.description ?? fallbackDescription).slice(0, 160);
const keywords = [
  event.name,
  `${event.city ?? event.county} events`,
  `${event.county} County events 2026`,
  event.category,
  "Central Coast events",
]
  .filter(Boolean)
  .join(", ");

// null for the undated events — an Event node without startDate is invalid, so
// those pages ship with no Event markup rather than a guessed date.
const jsonLd = buildRegionalEventJsonLd(event, site);
// Only emitted when the same questions render visibly below.
const faqJsonLd = buildFaqJsonLd(event);

// A sourced street address beats the county fallback — it puts the maps pin on
// the venue rather than on the middle of the city.
const mapQuery = event.streetAddress
  ? [event.venue, event.streetAddress, event.city, "CA", event.postalCode]
      .filter(Boolean)
      .join(", ")
  : [event.venue, event.city, `${event.county} County`, "CA"]
      .filter(Boolean)
      .join(", ");
const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapQuery)}`;

const others = eventsInMonth(month.key)
  .filter((e) => e.slug !== event.slug)
  .slice(0, 6);
---

<BaseLayout>
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="description" content={desc} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Monterey Bay Events" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1920" />
    <meta property="og:image:height" content="1088" />
    <meta property="og:image:alt" content={`${event.name} — ${month.label}`} />
    <meta property="article:section" content={`${event.county} County events`} />
    <meta property="article:tag" content={event.category} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={`${event.name} — ${month.label}`} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {faqJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}
  </Fragment>

  <main class="mx-auto max-w-4xl px-5 py-14">
    {event.county === "Monterey" && <FireAlert />}

    <a
      href={monthHref(month.key)}
      class="text-[0.65rem] font-bold uppercase tracking-[0.2em] text-muted-foreground hover:text-brass"
    >
      ← Central Coast events in {month.label}
    </a>

    <p class={`eyebrow mt-6 ${event.start ? "" : "text-muted-foreground"}`}>
      {dateLabel}
    </p>
    <h1 class="mt-2 text-5xl leading-[0.88] sm:text-7xl">{heading}</h1>

    <div class="mt-5 flex flex-wrap items-center gap-3">
      <span class="border border-border px-3 py-1 text-[0.6rem] font-semibold uppercase tracking-[0.16em] text-foreground">
        {event.category}
      </span>
      <span class="text-xs uppercase tracking-[0.16em] text-muted-foreground">
        {event.county} County
      </span>
      {
        event.admission === "free" && (
          <span class="border border-brass bg-brass/10 px-3 py-1 text-[0.6rem] font-semibold uppercase tracking-[0.16em] text-brass">
            Free admission
          </span>
        )
      }
    </div>

    {
      (event.intro ?? event.description) && (
        <p class="mt-8 max-w-3xl text-lg leading-relaxed text-muted-foreground">
          {event.intro ?? event.description}
        </p>
      )
    }

    <div class="mt-12 grid gap-10 sm:grid-cols-2">
      <section>
        <h2 class="border-b border-border/70 pb-2 text-2xl text-brass">When</h2>
        <p class="mt-4 text-base text-foreground">{dateLabel}</p>

        {
          event.times && (
            <ul class="mt-4 space-y-1">
              {event.times.map((t) => (
                <li class="text-sm text-foreground">
                  <span class="text-muted-foreground">{t.day}</span> — {t.hours}
                </li>
              ))}
            </ul>
          )
        }

        <p class="mt-4 text-sm leading-relaxed text-muted-foreground">
          {
            isPast
              ? event.times
                ? "This event has finished. The hours above are what was published for it at the time."
                : "This event has finished. No start time was published for it."
              : event.times && event.timesConfidence === "unconfirmed"
                ? "These hours come from a secondary listing. The organiser has not published door hours on its own page, so they are not carried in this page's structured data — the dates are. Confirm with the organiser before you plan a day around them."
                : event.times
                  ? "Hours as published by the organiser."
                  : event.start
                    ? "We don't have a confirmed start time for this one — the date is the organizer's published date. Check the official page before you travel."
                    : "The organizer has not published a 2026 date yet. This page will carry the date once one is announced — we don't estimate them."
          }
        </p>
        <a
          href={monthHref(month.key)}
          class="mt-4 inline-block text-sm text-brass hover:underline"
        >
          Everything else in {month.label} →
        </a>
      </section>

      <section>
        <h2 class="border-b border-border/70 pb-2 text-2xl text-brass">Where</h2>
        <div class="mt-4">
          {event.venue && <p class="text-base text-foreground">{event.venue}</p>}
          {event.streetAddress && (
            <p class="mt-1 text-sm text-muted-foreground">{event.streetAddress}</p>
          )}
          <p class={event.venue ? "mt-1 text-sm text-muted-foreground" : "text-base text-foreground"}>
            {event.city ?? event.cityText}
            {event.city ? `, ${event.county} County, CA` : ""}
            {event.postalCode ? ` ${event.postalCode}` : ""}
          </p>
          <a
            href={mapUrl}
            target="_blank"
            rel="noreferrer"
            class="mt-4 inline-block border border-border px-4 py-2 text-[0.65rem] font-bold uppercase tracking-[0.16em] text-muted-foreground transition-colors hover:border-brass hover:text-brass"
          >
            Open in maps ↗
          </a>
        </div>
      </section>
    </div>

    {
      event.officialWebsite && (
        <a
          href={event.officialWebsite}
          target="_blank"
          rel="noreferrer"
          class="mt-12 inline-block border border-brass bg-brass px-6 py-3 text-xs font-bold uppercase tracking-[0.18em] text-primary-foreground transition-opacity hover:opacity-85"
        >
          Official event page ↗
        </a>
      )
    }

    {
      !event.hideSources && event.referenceUrls.length > 0 && (
        <section class="mt-12">
          <h2 class="text-2xl text-brass">Where this listing comes from</h2>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
            The date, venue and category above were taken from these published
            sources. If one of them has changed, the organizer's own page wins.
          </p>
          <ul class="mt-3 space-y-1">
            {event.referenceUrls.map((url) => (
              <li>
                <a
                  href={url}
                  target="_blank"
                  rel="noreferrer nofollow"
                  class="break-all text-sm text-muted-foreground hover:text-brass"
                >
                  {url}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      event.sections && event.sections.length > 0 && (
        <div class="mt-14 max-w-3xl space-y-10">
          {event.sections.map((sec) => (
            <section>
              <h2 class="border-b border-border/70 pb-2 text-2xl text-brass">
                {sec.heading}
              </h2>
              {sec.body.map((para) => (
                <p class="mt-4 text-base leading-relaxed text-muted-foreground">
                  {para}
                </p>
              ))}
            </section>
          ))}
        </div>
      )
    }

    {
      event.faq && event.faq.length > 0 && (
        <section class="mt-14 max-w-3xl">
          <h2 class="border-b border-border/70 pb-2 text-2xl text-brass">
            Common questions
          </h2>
          <dl class="mt-6 space-y-6">
            {event.faq.map((f) => (
              <div>
                <dt class="text-lg font-semibold text-foreground">{f.q}</dt>
                <dd class="mt-2 text-base leading-relaxed text-muted-foreground">
                  {f.a}
                </dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }

    {
      others.length > 0 && (
        <section class="mt-16 border-t border-border/70 pt-8">
          <h2 class="text-2xl text-brass">Also in {month.label}</h2>
          <div class="mt-4 grid gap-2 sm:grid-cols-2">
            {others.map((o) => (
              <a
                href={eventHref(o)}
                class="border-l-2 border-border/80 bg-surface/60 px-4 py-3 text-sm text-foreground transition-colors hover:border-brass hover:text-brass"
              >
                {o.name}
              </a>
            ))}
          </div>
          <a
            href="/events/"
            class="mt-6 inline-block text-[0.65rem] font-bold uppercase tracking-[0.2em] text-muted-foreground hover:text-brass"
          >
            All 2026 Central Coast events →
          </a>
        </section>
      )
    }

    <section class="mt-12 border-t border-border/70 pt-8">
      <p class="max-w-2xl text-sm leading-relaxed text-muted-foreground">
        {
          carWeekIsPast ? (
            <Fragment>
              Monterey Car Week ran August 7–16 and reshapes traffic across both
              counties while it does. The{" "}
              <a href="/monterey-car-week/" class="text-brass hover:underline">
                Car Week section
              </a>{" "}
              keeps the 2026 schedule, and the{" "}
              <a href="/traffic/" class="text-brass hover:underline">
                traffic, closures and parking guide
              </a>{" "}
              covers road closures across the Peninsula, including the Highway 1
              closure through Big Sur that is still in force.
            </Fragment>
          ) : (
            <Fragment>
              Visiting the Peninsula in August? Monterey Car Week runs August 7–16
              and reshapes traffic across both counties while it does. The{" "}
              <a href="/free/" class="text-brass hover:underline">
                free Car Week events list
              </a>{" "}
              covers everything you can watch without a ticket, and the{" "}
              <a href="/traffic/" class="text-brass hover:underline">
                traffic, closures and parking guide
              </a>{" "}
              covers the road closures and parking that affect getting anywhere on
              the Peninsula that week — including to events that have nothing to do
              with cars.
            </Fragment>
          )
        }
      </p>
    </section>
  </main>
</BaseLayout>
