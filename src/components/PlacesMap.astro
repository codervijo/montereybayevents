---
// Generic Leaflet + OpenStreetMap map of places, with a category filter and a
// "free only" toggle (v7.B, first used by /things-to-do/<town>/).
//
// Same loading model as HolidayLightsMap: Leaflet JS + CSS and the OSM tiles
// load only when the map scrolls near the viewport, so the first paint is the
// server-rendered list. Circle markers coloured by category, no marker images.
// The filters also hide/show every element carrying `data-place="<id>"` and any
// `data-place-group` wrapper left empty.
//
// HolidayLightsMap.astro predates this and keeps its own date filters; moving
// it onto this component is a tracked refactor (docs/prd.md, v7.B row).
export type MapPoint = {
  id: string;
  name: string;
  category: string;
  lat: number;
  lng: number;
  free: boolean;
  lines: (string | null)[];
  href: string;
  directions: string;
};
interface Props {
  points: MapPoint[];
  categories: Record<string, { label: string; color: string }>;
  label: string;
  height?: string;
}
const { points, categories, label, height = "min(65vh, 520px)" } = Astro.props;
const present = Object.entries(categories).filter(([k]) => points.some((p) => p.category === k));
const field = "w-full border border-border bg-surface px-2 py-2 text-sm text-foreground";
---

<div class="places-map-wrap">
  <form class="places-filters grid grid-cols-2 gap-2 sm:grid-cols-3" aria-label={`Filter: ${label}`} onsubmit="return false">
    <label class="text-[0.65rem] uppercase tracking-[0.14em] text-muted-foreground">
      Type
      <select name="category" class={field}>
        <option value="">Everything</option>
        {present.map(([k, c]) => <option value={k}>{c.label}</option>)}
      </select>
    </label>
    <label class="flex items-center gap-2 self-end py-2 text-sm text-foreground">
      <input type="checkbox" name="free" class="h-4 w-4 accent-[#ddb049]" /> Free only
    </label>
  </form>
  <p class="places-count mt-2 text-xs text-muted-foreground" aria-live="polite"></p>
  <div class="places-map mt-3 w-full border border-border bg-surface" style={`height:${height}`} role="region" aria-label={label}>
    <noscript><p class="p-4 text-sm text-muted-foreground">The map needs JavaScript; every place is listed below with directions.</p></noscript>
  </div>
  <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs text-muted-foreground" aria-label="Map key">
    {present.map(([, c]) => (
      <li class="flex items-center gap-1.5">
        <span class="inline-block h-3 w-3 rounded-full border border-white/70" style={`background:${c.color}`}></span>{c.label}
      </li>
    ))}
  </ul>
  <script type="application/json" class="places-data" set:html={JSON.stringify({ categories, points })} />
</div>

<script>
  type P = { id: string; name: string; category: string; lat: number; lng: number; free: boolean; lines: (string | null)[]; href: string; directions: string };
  for (const wrap of document.querySelectorAll<HTMLElement>(".places-map-wrap")) {
    const data = JSON.parse(wrap.querySelector(".places-data")!.textContent!) as {
      categories: Record<string, { label: string; color: string }>; points: P[];
    };
    const form = wrap.querySelector<HTMLFormElement>(".places-filters")!;
    const count = wrap.querySelector<HTMLElement>(".places-count")!;
    const mapEl = wrap.querySelector<HTMLElement>(".places-map")!;
    const markers = new Map<string, any>();
    let map: any;

    const visible = () => {
      const f = new FormData(form);
      const cat = f.get("category"), free = f.has("free");
      return new Set(data.points.filter((p) => (!cat || p.category === cat) && (!free || p.free)).map((p) => p.id));
    };
    const apply = () => {
      const ids = visible();
      count.textContent = `Showing ${ids.size} of ${data.points.length} places`;
      for (const el of document.querySelectorAll<HTMLElement>("[data-place]")) el.hidden = !ids.has(el.dataset.place!);
      for (const g of document.querySelectorAll<HTMLElement>("[data-place-group]"))
        g.hidden = !g.querySelector("[data-place]:not([hidden])");
      if (!map) return;
      const shown: [number, number][] = [];
      for (const [id, m] of markers) {
        if (ids.has(id)) { m.addTo(map); shown.push(m.getLatLng()); } else m.remove();
      }
      if (shown.length) map.fitBounds(shown, { padding: [24, 24], maxZoom: 15 });
    };
    form.addEventListener("change", apply);
    apply();

    const load = async () => {
      const [{ default: L }] = await Promise.all([import("leaflet"), import("leaflet/dist/leaflet.css")]);
      mapEl.innerHTML = "";
      map = L.map(mapEl, { scrollWheelZoom: false });
      L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
        maxZoom: 19,
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
      }).addTo(map);
      for (const p of data.points) {
        const box = document.createElement("div");
        const h = document.createElement("strong"); h.textContent = p.name; box.append(h);
        for (const line of [data.categories[p.category]?.label, ...p.lines]) {
          if (!line) continue;
          const d = document.createElement("div"); d.textContent = line; box.append(d);
        }
        const links = document.createElement("div");
        links.innerHTML = `<a href="${p.href}">Details</a> · <a href="${p.directions}" target="_blank" rel="noopener">Directions</a>`;
        box.append(links);
        markers.set(p.id, L.circleMarker([p.lat, p.lng], {
          radius: 8, color: "#fff", weight: 2, fillColor: data.categories[p.category]?.color ?? "#ddb049", fillOpacity: 0.95,
        }).bindPopup(box).bindTooltip(p.name));
      }
      apply();
    };
    const io = new IntersectionObserver((es) => { if (es.some((x) => x.isIntersecting)) { io.disconnect(); load(); } }, { rootMargin: "300px" });
    io.observe(mapEl);
  }
</script>
