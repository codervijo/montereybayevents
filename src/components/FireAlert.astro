---
/**
 * Active-incident banner for the Timber Fire.
 *
 * Rendered at the top of every page a Car Week visitor is likely to land on,
 * because someone reading a schedule page is exactly the person about to drive
 * somewhere. `variant="full"` is the version on /traffic/, which is where the
 * detail belongs; everywhere else gets `variant="compact"` — the one sentence
 * that changes a decision, plus a link through.
 *
 * Nothing here is a live feed. Volatile figures carry an explicit "as of" and
 * every one of them links to CAL FIRE, so a reader can see how old our reading
 * is instead of trusting a number that may have doubled since. When the
 * incident closes, set `timberFire.active = false` in src/data/traffic.ts —
 * a stale emergency banner is worse than none at all.
 */
import { timberFire as fire } from "../data/traffic";

interface Props {
  variant?: "full" | "compact";
}
const { variant = "compact" } = Astro.props;
---

{
  fire.active && variant === "compact" && (
    <aside
      role="alert"
      class="mx-auto mt-6 max-w-4xl border-l-4 border-destructive bg-surface-raised px-5 py-4"
    >
      <p class="text-[0.65rem] font-bold uppercase tracking-[0.2em] text-destructive">
        Active wildfire · {fire.name}
      </p>
      <p class="mt-2 text-sm leading-relaxed text-foreground">{fire.headline}</p>
      <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
        {fire.detour}
      </p>
      <div class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-xs">
        <a href="/traffic/#timber-fire" class="font-semibold text-brass hover:underline">
          Full closure &amp; evacuation detail →
        </a>
        <a
          href={fire.sources[0]!.url}
          target="_blank"
          rel="noreferrer"
          class="text-brass hover:underline"
        >
          Live status from CAL FIRE ↗
        </a>
      </div>
    </aside>
  )
}

{
  fire.active && variant === "full" && (
    <section
      id="timber-fire"
      role="alert"
      class="scroll-mt-32 border-l-4 border-destructive bg-surface-raised px-6 py-6"
    >
      <p class="text-[0.65rem] font-bold uppercase tracking-[0.2em] text-destructive">
        Active wildfire
      </p>
      <h2 class="mt-2 text-3xl leading-none sm:text-4xl">
        {fire.name} — {fire.where}
      </h2>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-foreground">
        {fire.headline}
      </p>

      <p class="mt-5 border-l-2 border-brass/50 pl-4 text-sm leading-relaxed text-muted-foreground">
        <span class="font-semibold text-brass">This is not a live feed.</span> A
        fire changes faster than this page does. {fire.size}, {fire.containment}, as
        of {fire.asOf} — check CAL FIRE below for the current figures rather than
        trusting these, and follow the county for evacuation changes. Started{" "}
        {fire.started}.
      </p>

      <div class="mt-6 grid gap-6 sm:grid-cols-2">
        <div>
          <h3 class="border-b border-border/70 pb-2 text-xl text-brass">
            Road closure
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
            {fire.roadClosure}
          </p>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
            {fire.detour}
          </p>
        </div>

        <div>
          <h3 class="border-b border-border/70 pb-2 text-xl text-brass">
            Evacuation zones
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
            <span class="font-semibold text-foreground">Orders:</span>{" "}
            {fire.evacuationOrders.join(", ")}
          </p>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
            <span class="font-semibold text-foreground">Warnings:</span>{" "}
            {fire.evacuationWarnings.join(", ")}
          </p>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
            {fire.evacuationPoint}
          </p>
        </div>
      </div>

      <div class="mt-6 grid gap-6 sm:grid-cols-2">
        <div>
          <h3 class="border-b border-border/70 pb-2 text-xl text-brass">
            What is closed
          </h3>
          <ul class="mt-3 space-y-2">
            {fire.closures.map((c) => (
              <li class="flex gap-3 text-sm leading-relaxed text-muted-foreground">
                <span class="text-brass">—</span>
                <span>{c}</span>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <h3 class="border-b border-border/70 pb-2 text-xl text-brass">
            Effect on Car Week
          </h3>
          <ul class="mt-3 space-y-2">
            {fire.eventImpact.map((c) => (
              <li class="flex gap-3 text-sm leading-relaxed text-muted-foreground">
                <span class="text-brass">—</span>
                <span>{c}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="mt-6 flex flex-wrap gap-3">
        {fire.sources.map((s) => (
          <a
            href={s.url}
            target="_blank"
            rel="noreferrer"
            class="border border-destructive/60 px-4 py-2 text-[0.65rem] font-bold uppercase tracking-[0.16em] text-destructive transition-colors hover:bg-destructive hover:text-destructive-foreground"
          >
            {s.label} ↗
          </a>
        ))}
      </div>
    </section>
  )
}
