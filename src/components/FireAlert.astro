---
/**
 * Active-incident banner for the Big Sur fires.
 *
 * Rendered at the top of every page a reader about to travel is likely to land
 * on — the Car Week pages while that ran, and Monterey County regional listings
 * for as long as the incident changes anyone's plans.
 *
 * `variant="full"` is the version on /traffic/, where the detail belongs;
 * everywhere else gets `variant="compact"` — the one statement that changes a
 * decision, plus a link through.
 *
 * THE FIGURES ARE LIVE AS OF THE LAST BUILD. Acreage, containment and the
 * as-of stamp come from CAL FIRE at build time via src/lib/fireStatus.ts, and
 * the daily rebuild Worker refreshes them each morning. They are no longer
 * typed by hand — between 25 and 28 August 2026 the hand-typed acreage went 46%
 * wrong while the site rebuilt cleanly every day.
 *
 * Two things the build cannot do, so the page says them out loud instead:
 *   - If the CAL FIRE read fails, it falls back to the hand-checked figures in
 *     src/data/traffic.ts AND states that it has, rather than quietly serving a
 *     stale number that looks current.
 *   - If Caltrans reports a wildfire closure on Highway 1 that contradicts
 *     `fire.roadClaim`, a correction strip renders above the description. The
 *     prose is still written by a person; this checks the one claim in it whose
 *     failure could send somebody toward a closed road.
 *
 * Everything else here — evacuation zones, what is closed, the narrative — is
 * hand-written and still goes stale. This narrows the error surface; it does
 * not remove it.
 *
 * The copy states facts and does not advise anyone how to travel. When the
 * incident closes, set `timberFire.active = false` in src/data/traffic.ts.
 */
import { timberFire as fire } from "../data/traffic";
import {
  fetchFireStatus,
  formatAcres,
  formatUpdated,
} from "../lib/fireStatus";

interface Props {
  variant?: "full" | "compact";
}
const { variant = "compact" } = Astro.props;

const status = await fetchFireStatus();
const live = status.incidents && status.incidents.length > 0 ? status.incidents : null;

// Caltrans and our prose disagree about Highway 1. `null` means the feed could
// not be read, which is not a disagreement.
const roadDrift =
  status.roadClosedForWildfire !== null &&
  status.roadClosedForWildfire !== (fire.roadClaim === "closed");
---

{
  fire.active && variant === "compact" && (
    <aside
      role="alert"
      class="mx-auto mt-6 max-w-4xl border-l-4 border-destructive bg-surface-raised px-5 py-4"
    >
      <p class="text-[0.65rem] font-bold uppercase tracking-[0.2em] text-destructive">
        Active wildfire · {fire.name}
      </p>
      <p class="mt-2 text-sm leading-relaxed text-foreground">{fire.headline}</p>
      <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
        {fire.detour}
      </p>
      <div class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-xs">
        <a href="/traffic/#timber-fire" class="font-semibold text-brass hover:underline">
          Full closure &amp; evacuation detail →
        </a>
        <a
          href={fire.sources[0]!.url}
          target="_blank"
          rel="noreferrer"
          class="text-brass hover:underline"
        >
          Live status from CAL FIRE ↗
        </a>
      </div>
    </aside>
  )
}

{
  fire.active && variant === "full" && (
    <section
      id="timber-fire"
      role="alert"
      class="scroll-mt-32 border-l-4 border-destructive bg-surface-raised px-6 py-6"
    >
      <p class="text-[0.65rem] font-bold uppercase tracking-[0.2em] text-destructive">
        Active wildfire
      </p>
      <h2 class="mt-2 text-3xl leading-none sm:text-4xl">
        {fire.name} — {fire.where}
      </h2>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-foreground">
        {fire.headline}
      </p>

      {roadDrift && (
        <p class="mt-5 border-2 border-destructive bg-destructive/10 px-4 py-3 text-sm leading-relaxed text-foreground">
          <span class="font-semibold text-destructive">
            Caltrans and this page disagree.
          </span>{" "}
          Caltrans currently reports Highway 1 in Monterey County as{" "}
          {status.roadClosedForWildfire ? "closed for a wildfire" : "carrying no wildfire closure"},
          and the description below says the opposite. The description was
          written by hand and is out of date. Caltrans is the authority.
        </p>
      )}

      <p class="mt-5 border-l-2 border-brass/50 pl-4 text-sm leading-relaxed text-muted-foreground">
        {live ? (
          <Fragment>
            <span class="font-semibold text-brass">Read from CAL FIRE.</span>{" "}
            {live.map((i, n) => (
              <Fragment>
                {n > 0 && " "}
                {i.name.trim()}: {formatAcres(i.acres)}, {i.containment}% contained.
              </Fragment>
            ))}{" "}
            Figures as of {formatUpdated(live[0]!.updated)}, taken from CAL FIRE's
            incident record when this page was last built. A fire changes faster
            than a page does; the CAL FIRE link below carries the current
            figures. Started {fire.started}.
          </Fragment>
        ) : (
          <Fragment>
            <span class="font-semibold text-destructive">
              Live figures unavailable.
            </span>{" "}
            CAL FIRE's incident record could not be read when this page was
            built, so these are the last figures checked by hand and they may be
            out of date: {fire.size}, {fire.containment}, as of {fire.asOf}. The
            CAL FIRE link below carries the current figures. Started{" "}
            {fire.started}.
          </Fragment>
        )}
      </p>

      <div class="mt-6 grid gap-6 sm:grid-cols-2">
        <div>
          <h3 class="border-b border-border/70 pb-2 text-xl text-brass">
            Road closure
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
            {fire.roadClosure}
          </p>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
            {fire.detour}
          </p>
        </div>

        <div>
          <h3 class="border-b border-border/70 pb-2 text-xl text-brass">
            Evacuation zones
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
            <span class="font-semibold text-foreground">Orders:</span>{" "}
            {fire.evacuationOrders.join(", ")}
          </p>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
            <span class="font-semibold text-foreground">Warnings:</span>{" "}
            {fire.evacuationWarnings.join(", ")}
          </p>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
            {fire.evacuationPoint}
          </p>
        </div>
      </div>

      <div class="mt-6 grid gap-6 sm:grid-cols-2">
        <div>
          <h3 class="border-b border-border/70 pb-2 text-xl text-brass">
            What is closed
          </h3>
          <ul class="mt-3 space-y-2">
            {fire.closures.map((c) => (
              <li class="flex gap-3 text-sm leading-relaxed text-muted-foreground">
                <span class="text-brass">—</span>
                <span>{c}</span>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <h3 class="border-b border-border/70 pb-2 text-xl text-brass">
            Effect on listed events
          </h3>
          <ul class="mt-3 space-y-2">
            {fire.eventImpact.map((c) => (
              <li class="flex gap-3 text-sm leading-relaxed text-muted-foreground">
                <span class="text-brass">—</span>
                <span>{c}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="mt-6 flex flex-wrap gap-3">
        {fire.sources.map((s) => (
          <a
            href={s.url}
            target="_blank"
            rel="noreferrer"
            class="border border-destructive/60 px-4 py-2 text-[0.65rem] font-bold uppercase tracking-[0.16em] text-destructive transition-colors hover:bg-destructive hover:text-destructive-foreground"
          >
            {s.label} ↗
          </a>
        ))}
      </div>
    </section>
  )
}
