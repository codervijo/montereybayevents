---
import { ROAD_CLOSURES_URL } from "../data/events";
import { EMAIL_ENDPOINT, EMAIL_PITCH } from "../lib/newsletter";
---

<footer class="border-t border-border/70 bg-surface">
  <div class="mx-auto grid max-w-6xl gap-8 px-5 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="font-display text-3xl leading-none text-brass">
        Monterey Bay
        <br />
        Events
      </p>
      <p class="mt-3 text-sm text-muted-foreground">
        Public events across Monterey and Santa Cruz counties, California.
      </p>
    </div>

    <div class="text-sm">
      <p class="eyebrow mb-3">Explore</p>
      <ul class="space-y-2 text-muted-foreground">
        <li>
          <a href="/monterey-car-week/" class="transition-colors hover:text-foreground">
            Monterey Car Week 2026
          </a>
        </li>
        <li>
          <a
            href="/monterey-car-week/schedule/"
            class="transition-colors hover:text-foreground"
          >
            Full ten-day schedule
          </a>
        </li>
        <li>
          <a href="/free/" class="transition-colors hover:text-foreground">
            Free Car Week events
          </a>
        </li>
        <li>
          <a href="/traffic/" class="transition-colors hover:text-foreground">
            Traffic, closures &amp; safety
          </a>
        </li>
        <li>
          <a
            href={ROAD_CLOSURES_URL}
            target="_blank"
            rel="noreferrer"
            class="transition-colors hover:text-foreground"
          >
            County road closure info
          </a>
        </li>
      </ul>
    </div>

    <div class="text-sm text-muted-foreground">
      <p class="eyebrow mb-3">Permits &amp; public safety</p>
      <p>
        County of Monterey Permit Center
        <br />
        <a href="tel:8317555025" class="text-foreground hover:text-brass">
          831-755-5025
        </a>
      </p>
      <p class="mt-3">
        Text <span class="text-brass">CARWEEK</span> to{" "}
        <span class="text-brass">65513</span> for public safety alerts.
      </p>
    </div>

    <!--
      Email capture. Inline in the footer on every page — no modal, no popup.
      Submits to EMAIL_ENDPOINT (src/lib/newsletter.ts), which is an empty string
      until a real endpoint is chosen; while it is empty the handler blocks the
      POST and says so rather than silently dropping an address.
    -->
    <div class="text-sm">
      <p class="eyebrow mb-3">Newsletter</p>
      <form
        data-newsletter
        data-endpoint={EMAIL_ENDPOINT}
        action={EMAIL_ENDPOINT}
        method="post"
        class="flex flex-col gap-3"
      >
        <label for="footer-email" class="leading-relaxed text-muted-foreground">
          {EMAIL_PITCH}
        </label>
        <input
          id="footer-email"
          type="email"
          name="email"
          required
          autocomplete="email"
          placeholder="you@example.com"
          class="w-full border border-border bg-background px-3 py-2 text-sm text-foreground placeholder:text-muted-foreground/60 focus:border-brass focus:outline-none"
        />
        <button
          type="submit"
          class="w-fit border border-brass bg-brass px-5 py-2.5 text-[0.65rem] font-bold uppercase tracking-[0.18em] text-primary-foreground transition-opacity hover:opacity-85"
        >
          Subscribe
        </button>
        <p
          data-newsletter-status
          role="status"
          aria-live="polite"
          class="text-xs leading-relaxed text-muted-foreground"
        >
        </p>
      </form>
    </div>
  </div>

  <div
    class="border-t border-border/70 px-5 py-5 text-center text-xs text-muted-foreground"
  >
    A guide from Monterey Bay Events · montereybayevents.com — event details are
    provided by organizers and subject to change.
  </div>
</footer>

<script>
  // Progressive enhancement: without JS the form does a native POST to
  // EMAIL_ENDPOINT (and does nothing at all while that is empty, since the
  // submit is blocked below). The endpoint is read from the rendered markup so
  // this stays a plain module script with no build-time interpolation.
  const form = document.querySelector<HTMLFormElement>("form[data-newsletter]");
  const status = form?.querySelector<HTMLElement>("[data-newsletter-status]");

  form?.addEventListener("submit", async (e) => {
    const endpoint = form.dataset.endpoint?.trim();
    const input = form.querySelector<HTMLInputElement>('input[name="email"]');

    if (!endpoint) {
      // TODO(operator): remove this branch once EMAIL_ENDPOINT is set.
      e.preventDefault();
      if (status) {
        status.textContent = "Signups aren't open yet — the list goes live shortly.";
      }
      return;
    }

    e.preventDefault();
    if (status) status.textContent = "Signing you up…";

    try {
      const res = await fetch(endpoint, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email: input?.value ?? "" }),
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      if (status) status.textContent = "You're on the list. One email a week.";
      form.reset();
    } catch {
      if (status) {
        status.textContent = "That didn't go through — please try again in a moment.";
      }
    }
  });
</script>
