---
// Jazz Bash Monterey — evergreen event page.
//
// SEPARATE EVENT FROM THE MONTEREY JAZZ FESTIVAL. Different organiser,
// different venues, different month, different music. They are not merged and
// must not be: MJF is September at the Fairgrounds and lives at
// /event/monterey-jazz-festival/. If you are here to edit one of them, check
// which.
//
// WHY THIS IS A STANDALONE PAGE AND NOT A ROW IN events-2026.ts:
// that dataset is transcribed from data/monterey_santacruz_events_aug_dec_2026.csv
// and src/__tests__/events2026.test.js asserts exactly 61 rows, every one
// present in the CSV and no extras. Jazz Bash is not in the CSV and its dates
// fall outside the Aug-Dec 2026 window the file covers, so adding a row there
// would fail the build. Guide-page shape, on the /laguna-seca/camping/
// precedent.
//
// DATES: 5-7 March 2027, from the organiser's own homepage. The brief named
// "March 6-8, 2026", which is the PAST edition — that one ran Fri-Sun too, and
// the calendar simply moved. Weekday-checked with `date -d`: 5 March 2027 is a
// Friday and 7 March a Sunday, so the Fri-Sun pattern holds.
//
// EVENT_DATES being non-null is what switches the Event JSON-LD on. Set it back
// to null rather than guessing if a future edition's dates are unannounced;
// schema.org/Event requires startDate and a node with a guessed one is worse
// than no node.
//
// The JSON-LD location is the Portola, not the Conference Center: the organiser
// publishes an address for headquarters only, and naming a Place we cannot
// address would put a guess into map results.
import BaseLayout from "../layouts/BaseLayout.astro";

const site = "https://montereybayevents.com";
const title = "Jazz Bash Monterey — Dates, Venues, Tickets & Downtown Parking";
const description =
  "Traditional jazz and swing across the Monterey Conference Center and the Portola Hotel & Spa. Dates, venues, what a badge costs and where to park downtown.";
// trailingSlash: 'always' in astro.config.mjs — the canonical MUST end in a
// slash or it 308-redirects and the page comes back "unknown to Google".
// Enforced by CHECK_161.
const canonical = `${site}/jazz-bash-monterey/`;

const OFFICIAL = "https://jazzbashmonterey.com/";

/**
 * Set this ONLY from the organiser's own published dates — never from
 * arithmetic on last year's. When it is set, the Event JSON-LD below renders;
 * while it is null, the page says the dates are not yet confirmed and emits no
 * Event node at all.
 *
 *   { start: "2027-03-05", end: "2027-03-07", text: "March 5-7, 2027" }
 *
 * Cross-check the weekday against the date with `date -d <ISO> +%A` before you
 * write it — a day name that does not match its date means you are reading a
 * previous year's page. That check is a standing rule on this site; see
 * docs/CLAUDE.md.
 */
const EVENT_DATES: { start: string; end: string; text: string } | null = {
  start: "2027-03-05",
  end: "2027-03-07",
  text: "March 5-7, 2027",
};

const VENUES = [
  {
    name: "Portola Hotel & Spa",
    note: "2 Portola Plaza, Monterey CA 93940. The organiser calls it festival headquarters, and it is the only venue whose address they publish.",
  },
  {
    name: "Monterey Conference Center",
    note: "Adjoining the Portola on Portola Plaza. The festival names it as a venue but publishes no separate address for it.",
  },
];

const eventJsonLd = EVENT_DATES
  ? {
      "@context": "https://schema.org",
      "@type": "Event",
      name: "Jazz Bash Monterey",
      startDate: EVENT_DATES.start,
      endDate: EVENT_DATES.end,
      eventStatus: "https://schema.org/EventScheduled",
      eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
      location: {
        "@type": "Place",
        name: "Portola Hotel & Spa",
        streetAddress: "2 Portola Plaza",
        address: {
          "@type": "PostalAddress",
          streetAddress: "2 Portola Plaza",
          addressLocality: "Monterey",
          addressRegion: "CA",
          postalCode: "93940",
          addressCountry: "US",
        },
      },
      url: OFFICIAL,
    }
  : null;
---

<BaseLayout>
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="description" content={description.slice(0, 155)} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description.slice(0, 200)} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Monterey Bay Events" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={`${site}/og-default.jpg`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description.slice(0, 200)} />
    <meta name="twitter:image" content={`${site}/og-default.jpg`} />

    {/* Renders only once EVENT_DATES is filled from the organiser. An Event
        node without a startDate is invalid; one with a guessed startDate is
        worse than invalid. */}
    {eventJsonLd && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(eventJsonLd)}
      />
    )}
  </Fragment>

  <main class="mx-auto max-w-3xl px-5 py-14">
    <a
      href="/events/"
      class="text-[0.65rem] font-bold uppercase tracking-[0.2em] text-muted-foreground hover:text-brass"
    >
      ← All Central Coast events
    </a>

    <h1 class="mt-6 text-5xl leading-[0.9] sm:text-6xl">
      Jazz Bash <span class="text-brass">Monterey</span>
    </h1>

    <p class="mt-4 text-sm uppercase tracking-[0.18em] text-muted-foreground">
      {EVENT_DATES ? EVENT_DATES.text : "Dates for the next edition not yet confirmed"}
      {" · "}Downtown Monterey
    </p>

    <p class="mt-7 text-lg leading-relaxed text-muted-foreground">
      Jazz Bash Monterey is a traditional jazz and swing festival held across
      two adjoining downtown venues, the Monterey Conference Center and the
      Portola Hotel &amp; Spa. It is a different event from the Monterey Jazz
      Festival, which runs in September at the Fairgrounds — if that is the one
      you are looking for, it is
      <a href="/event/monterey-jazz-festival/" class="text-brass hover:underline">
        here</a>.
    </p>

    <section class="mt-14">
      <h2 class="border-b border-border/70 pb-2 text-3xl text-brass">Dates</h2>
      <p class="mt-5 text-base leading-relaxed text-muted-foreground">
        Friday 5 to Sunday 7 March 2027, the organiser's own published dates.
        If you have seen March 6–8 quoted, that was the 2026 festival, which
        has already happened — the two are a day apart because the festival
        runs Friday to Sunday and the calendar moved.
      </p>
      <p class="mt-4 text-base leading-relaxed text-muted-foreground">
        A 2027 band schedule and set times are not published yet. The festival
        posts its running order as a PDF closer to the date.
      </p>
    </section>

    <section class="mt-14">
      <h2 class="border-b border-border/70 pb-2 text-3xl text-brass">Venues</h2>
      <ul class="mt-5 space-y-4">
        {VENUES.map((v) => (
          <li class="text-base leading-relaxed text-muted-foreground">
            <span class="text-foreground">{v.name}</span> — {v.note}
          </li>
        ))}
      </ul>
      <p class="mt-4 text-base leading-relaxed text-muted-foreground">
        The two sit side by side on Portola Plaza in downtown Monterey and the
        festival moves between them, so the walk between venues is a short one.
        Which bands play which rooms is set by the band schedule rather than
        fixed, and that is not out for 2027 yet.
      </p>
    </section>

    <section class="mt-14">
      <h2 class="border-b border-border/70 pb-2 text-3xl text-brass">Tickets</h2>
      <p class="mt-5 text-base leading-relaxed text-muted-foreground">
        Badge prices for 2027 are not published. The festival's own badges page
        says only "Please check back soon", so there is no all-event price,
        no single-day price and no early-bird deadline to report yet — and no
        previous year's figure is repeated here in place of one, because this
        festival has priced early-bird badges against a January deadline
        before, and a stale number is worst exactly when someone is deciding
        whether to buy now.
      </p>
      <p class="mt-4 text-base leading-relaxed text-muted-foreground">
        One thing that is published: a Friends of Note donation of $25 or more
        per person collects a commemorative pin at the festival's will-call
        desk. That is a donation, not admission.
      </p>
    </section>

    <section class="mt-14">
      <h2 class="border-b border-border/70 pb-2 text-3xl text-brass">
        Parking downtown
      </h2>
      <p class="mt-5 text-base leading-relaxed text-muted-foreground">
        Both venues sit in downtown Monterey, where parking is structured and
        paid rather than on-street and free.
      </p>
      <p class="mt-4 text-base leading-relaxed text-muted-foreground">
        Parking at the Portola itself is limited, in the festival's own words.
        It points instead at two large public garages nearby, the East and West
        Garages on Portola Plaza. Neither the festival nor its venue page
        publishes garage rates, closing times or any festival validation, so
        budget for downtown garage pricing and check the tariff at the gate.
      </p>
    </section>

    <section class="mt-14">
      <h2 class="border-b border-border/70 pb-2 text-3xl text-brass">
        Where to stay
      </h2>
      <p class="mt-5 text-base leading-relaxed text-muted-foreground">
        There is a room block, and it has a deadline. The Portola Hotel &amp;
        Spa is festival headquarters and holds rooms at $252 single or double.
        The rate is held until <strong class="text-foreground">Tuesday 2
        February 2027</strong>, and booking is by phone on (866) 711-1734 —
        you have to say "Dixieland Jazz Bash Monterey 2027" to get it, which is
        the festival's older name and not what the website is called.
      </p>
      <p class="mt-4 text-base leading-relaxed text-muted-foreground">
        The festival also lists seven RV parks around the county, from the
        Monterey County Fair &amp; Event Center RV Park to Laguna Seca
        Recreation Area, and points at See Monterey for everything else.
      </p>
    </section>

    <section class="mt-14 border-t border-border/70 pt-8">
      <p class="text-base leading-relaxed text-muted-foreground">
        Official site:{" "}
        <a href={OFFICIAL} target="_blank" rel="noreferrer" class="text-brass hover:underline">
          jazzbashmonterey.com ↗
        </a>
      </p>
    </section>
  </main>
</BaseLayout>
