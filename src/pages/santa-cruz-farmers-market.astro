---
// Every certified farmers market in Santa Cruz County that its operator
// confirms is running — rendered by FarmersMarketPage. Data and all date logic:
// src/data/farmersMarkets.ts.
import FarmersMarketPage from "../components/FarmersMarketPage.astro";
import { pacificToday } from "../lib/isPast";
import {
  formatHours,
  openTodayLine,
  santaCruzCountyMarkets as markets,
  santaCruzSkipped,
  sessionsOn,
} from "../data/farmersMarkets";

const today = pacificToday();
const place = "Santa Cruz County";
const byId = Object.fromEntries(markets.map((m) => [m.id, m]));
const hrs = (id: string) => formatHours(byId[id].hours[0]);

const todayLine = openTodayLine(today, markets, place);
const todayAnswer = sessionsOn(today, markets).length
  ? `Yes. ${todayLine}`
  : `Not today. ${todayLine}`;

const faq = [
  {
    q: "Is there a farmers market in Santa Cruz today?",
    a: `${todayAnswer} Year round, Santa Cruz County has a market every Wednesday, Saturday and Sunday.`,
  },
  {
    q: "What day is the Santa Cruz farmers market?",
    a: `Santa Cruz has three: Wednesday downtown on Cedar Street (${hrs("downtown-santa-cruz")}), Saturday on the Westside at Mission Street Extension and Western Drive (${hrs("westside-santa-cruz")}), and Sunday in Live Oak at 15th Avenue and East Cliff Drive (${hrs("live-oak")}). All three run year round.`,
  },
  {
    q: "What are the hours of the Santa Cruz farmers markets?",
    a: `Downtown (Wednesday): ${hrs("downtown-santa-cruz")}. Westside (Saturday): ${hrs("westside-santa-cruz")}. Live Oak (Sunday): ${hrs("live-oak")}. Aptos at Cabrillo College (Saturday): ${hrs("aptos-cabrillo")}. Scotts Valley (Saturday, seasonal): ${hrs("scotts-valley")}. Felton (Tuesday, seasonal): ${hrs("felton")}.`,
  },
  {
    q: "Are the Santa Cruz farmers markets open year round?",
    a: `Four are: Downtown, Westside, Live Oak and Aptos. Two are seasonal. Felton's 2026 season runs to Tuesday 27 October and Scotts Valley's to Saturday 21 November, and neither operator has published a 2027 opening date yet.`,
  },
  {
    q: "Do Santa Cruz farmers markets take EBT and Market Match?",
    a: `Yes. At all five Santa Cruz Community Farmers' Markets — Downtown, Westside, Live Oak, Scotts Valley and Felton — EBT is redeemed at the information booth and matched dollar for dollar in Market Match tokens for fruit and vegetables, up to $15. At Aptos, EBT is processed 8–11am at the Information Booth; its operator does not mention Market Match.`,
  },
  {
    q: "Where do I park for the Santa Cruz farmers markets?",
    a: `Westside and Aptos have free parking on site — the Westside operator describes "an abundance" of it. Downtown has a free bike valet and a Veggie Valet that holds your bags while you fetch the car. The operator publishes no parking guidance for Live Oak, Scotts Valley or Felton.`,
  },
  {
    q: "Can I bring my dog to a Santa Cruz farmers market?",
    a: `Not to Aptos: its operator prohibits animals other than service animals, citing the California Health and Safety Code. Santa Cruz Community Farmers' Markets, which runs the other five, publishes no pet policy.`,
  },
];
---

<FarmersMarketPage
  title="Santa Cruz County Farmers Markets: Schedule by Day (2026)"
  h1Lead="Santa Cruz Farmers Markets:"
  h1Accent="Days, Hours & Locations"
  description="Santa Cruz County farmers markets by day: Downtown Wednesdays, Westside and Aptos Saturdays, Live Oak Sundays — hours, seasons, EBT and Market Match."
  path="/santa-cruz-farmers-market/"
  place={place}
  markets={markets}
  areas={["Santa Cruz", "Live Oak", "Aptos", "Scotts Valley", "San Lorenzo Valley"]}
  intro="Santa Cruz County has four year-round farmers markets: Wednesday afternoon downtown, Saturday morning on the Westside and at Cabrillo College in Aptos, and Sunday morning in Live Oak. Two more, in Scotts Valley and Felton, are seasonal. Every day, time and address here comes from the market operators' own sites."
  faq={faq}
  skipped={santaCruzSkipped}
  sibling={{ href: "/monterey-farmers-market/", label: "Monterey County farmers markets" }}
  today={today}
>
  <link slot="head" rel="canonical" href="https://montereybayevents.com/santa-cruz-farmers-market/" />

  <section slot="after-table" class="mt-14">
    <h2 class="border-b border-border/70 pb-2 text-3xl text-brass">Which market fits your visit</h2>
    <ul class="mt-5 space-y-4">
      <li class="flex gap-3 text-base leading-relaxed text-muted-foreground">
        <span class="text-brass">—</span>
        <span>
          <strong class="text-foreground">A weekend in Santa Cruz, any time of year.</strong>{" "}
          Both days are covered. Saturday has the Westside market (9am–1pm) and
          Aptos at Cabrillo College (8am–noon). Sunday has Live Oak at 15th and
          East Cliff (9am–1pm).
        </span>
      </li>
      <li class="flex gap-3 text-base leading-relaxed text-muted-foreground">
        <span class="text-brass">—</span>
        <span>
          <strong class="text-foreground">A weekday lunch break downtown.</strong>{" "}
          The Downtown market runs Wednesday 12:30–5pm on Cedar Street, between
          Walnut and Church. It moved there in June 2025, so listings from before
          then may give its old location.
        </span>
      </li>
      <li class="flex gap-3 text-base leading-relaxed text-muted-foreground">
        <span class="text-brass">—</span>
        <span>
          <strong class="text-foreground">Monday, Thursday or Friday.</strong>{" "}
          No market on this page runs on those days. Watsonville's Friday
          market exists, but its hours could not be confirmed from an operator
          source — see the note at the foot of the page.
        </span>
      </li>
      <li class="flex gap-3 text-base leading-relaxed text-muted-foreground">
        <span class="text-brass">—</span>
        <span>
          <strong class="text-foreground">Felton on a hot afternoon.</strong>{" "}
          This is the one most likely to catch you out. The operator cancels
          Felton at 95°F or under a National Weather Service heat advisory, and
          its season ends on Tuesday 27 October. Check before driving up
          Highway 9.
        </span>
      </li>
      <li class="flex gap-3 text-base leading-relaxed text-muted-foreground">
        <span class="text-brass">—</span>
        <span>
          <strong class="text-foreground">Shopping with CalFresh.</strong>{" "}
          The five Santa Cruz Community Farmers' Markets match EBT up to $15 in
          Market Match tokens — swipe $15 of EBT and you get another $15 in
          tokens to spend on fruit and vegetables. At Aptos, EBT stops at 11am, an hour before
          the market closes.
        </span>
      </li>
    </ul>
  </section>
  <section slot="after-markets" class="mt-14 border-l-2 border-brass bg-surface/60 px-6 py-8">
    <h2 class="text-3xl text-brass">Where other listings go wrong</h2>
    <p class="mt-5 text-base leading-relaxed text-muted-foreground">
      Several pages that rank for these markets give hours or seasons that
      their operators no longer publish. Checked against the operators' own
      pages on 4 October 2026:
    </p>
    <ul class="mt-5 space-y-4">
      <li class="text-base leading-relaxed text-muted-foreground">
        <strong class="text-foreground">Downtown's hours.</strong> Visit Santa
        Cruz County's listings and the Downtown Santa Cruz association's page
        give Wednesdays 1–5pm. The operator says 12:30–5pm, so the first half
        hour is missing from those listings.
      </li>
      <li class="text-base leading-relaxed text-muted-foreground">
        <strong class="text-foreground">Downtown's location.</strong> The
        Downtown association's page describes the market in Lot 16 off Church
        Street, wrapping onto the 800 block of Cedar. Since 4 June 2025 it has run along Cedar Street from Walnut
        Avenue to Church, around the corner onto Church and into the small lot
        there.
      </li>
      <li class="text-base leading-relaxed text-muted-foreground">
        <strong class="text-foreground">"Year round" for Felton and Scotts Valley.</strong>{" "}
        The operator's own home page lists both among its year-round markets,
        but each market's own page gives a season: Felton runs 5 May to 27
        October, Scotts Valley 2 May to 21 November. This page follows the
        market pages.
      </li>
    </ul>
  </section>
</FarmersMarketPage>
