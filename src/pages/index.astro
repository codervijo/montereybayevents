---
// src/pages/index.astro — the Monterey Bay events calendar (v2.O).
//
// Site-level page: Organization + WebSite JSON-LD live here, plus an ItemList
// of the events this page actually lists and a FAQPage built from the same
// array the visible FAQ renders. The Car Week hub (with its own Event JSON-LD)
// is at /monterey-car-week/.
//
// EVERY LIST ON THIS PAGE IS COMPUTED AT BUILD from src/data/events-2026.ts and
// src/data/farmersMarkets.ts — no date is typed into this file except the one
// sourced 2027 Car Week date below. The daily rebuild Worker is what keeps
// "this weekend" and "next 30 days" current; without a rebuild `pacificToday()`
// freezes at the last push. Nothing here is invented: an event with no
// announced date says so, and Free/Paid appears only where `admission` is set
// from the organiser's own words.
//
// The dataset ends 2026-12-31. From January the weekend and 30-day lists fall
// through to their empty states rather than showing a stale set.
import BaseLayout from "../layouts/BaseLayout.astro";
import FireAlert from "../components/FireAlert.astro";
import { totalFreeListings } from "../data/eventIndex";
import {
  DATE_TBA,
  MONTHS,
  currentAndNextMonth,
  eventHref,
  eventsInMonth,
  monthHref,
  regionalEvents,
  type RegionalEvent,
} from "../data/events-2026";
import {
  addDays,
  formatDay,
  formatHours,
  montereyCountyMarkets,
  santaCruzCountyMarkets,
  sessionsOn,
  weekdayOf,
  WEEKDAYS,
} from "../data/farmersMarkets";
import { isPastDate, pacificToday } from "../lib/isPast";

const site = "https://montereybayevents.com";
const canonical = `${site}/`;
// Title at or under 60 chars (CHECK_070); the brief's 75-char version was cut
// to this by operator decision. Description is a literal so the conformance
// checker, which reads source and does not evaluate interpolation, measures
// the same 120-160 chars the browser renders (CHECK_071).
const title = "Monterey Bay Events Calendar — Monterey & Santa Cruz County";
const description =
  "What's on around Monterey Bay this weekend and this month: festivals, fairs, markets and holiday events in Monterey and Santa Cruz counties.";

/** Where event submissions go. Operator-supplied 2026-10-16. */
const SUBMIT_EMAIL = "hello@lamill.io";

// Pebble Beach Concours 2027 — organiser-stated, the one sourced 2027 Car Week
// date. Same constant and source as CONCOURS_2027 in
// src/pages/monterey-car-week/index.astro; change both together. The overall
// week window is NOT published, so none is shown.
const CONCOURS_2027_TEXT = "Sunday 15 August 2027";

const today = pacificToday();
const year = (iso: string) => iso.slice(0, 4);
const longDate = (iso: string) => `${formatDay(iso)} ${year(iso)}`;

// ── Windows ───────────────────────────────────────────────────────────────
// "This weekend" is Friday to Sunday. Mon–Thu it means the coming weekend;
// Fri–Sun it means the one we are in, starting today.
const dayIdx = WEEKDAYS.indexOf(weekdayOf(today)); // Monday = 0
const friday = addDays(today, 4 - dayIdx);
const sunday = addDays(friday, 2);
const weekendFrom = friday > today ? friday : today;
const horizon = addDays(today, 30);

const overlaps = (e: RegionalEvent, from: string, to: string) =>
  !!e.start && e.start <= to && (e.end ?? e.start) >= from;

const upcoming = regionalEvents
  .filter((e) => e.start && !isPastDate(e.start, e.end, today))
  .sort((a, b) => (a.start! < b.start! ? -1 : a.start! > b.start! ? 1 : a.name.localeCompare(b.name)));

const weekendEvents = upcoming.filter((e) => overlaps(e, weekendFrom, sunday)).slice(0, 10);
// Empty weekend → show what is next instead, and say so in the heading.
const weekendIsEmpty = weekendEvents.length === 0;
const weekendList = weekendIsEmpty ? upcoming.slice(0, 6) : weekendEvents;
const weekendLabel =
  weekendFrom === sunday
    ? formatDay(sunday)
    : `${formatDay(weekendFrom)} – ${formatDay(sunday)}`;

const shown = new Set(weekendList.map((e) => e.slug));
const nextThirty = upcoming
  .filter((e) => !shown.has(e.slug) && overlaps(e, addDays(sunday, 1), horizon))
  .slice(0, 15);
// Fewer than 10 inside 30 days → continue with what comes after, marked as such.
const furtherAhead =
  nextThirty.length < 10
    ? upcoming
        .filter((e) => !shown.has(e.slug) && !nextThirty.includes(e) && e.start! > horizon)
        .slice(0, 10 - nextThirty.length)
    : [];

// Farmers markets open over the weekend window — a weekly rule, not an event,
// so they get one line rather than places in the list.
const allMarkets = [...montereyCountyMarkets, ...santaCruzCountyMarkets];
const weekendDays = [0, 1, 2].map((i) => addDays(friday, i)).filter((d) => d >= today);
const weekendMarkets = weekendDays.flatMap((d) => sessionsOn(d, allMarkets));

const listedUpcoming = [...weekendList, ...nextThirty, ...furtherAhead];
const withOrganiser = upcoming.filter((e) => e.officialWebsite).length;

// ── Months ────────────────────────────────────────────────────────────────
// The current month and the next five that have a hub page. The dataset only
// has hubs through December 2026, so this is often fewer than six.
const { current } = currentAndNextMonth(new Date());
const fromMonth = MONTHS.findIndex((m) => m.key === current.key);
const monthLinks = MONTHS.slice(fromMonth, fromMonth + 6).map((m) => ({
  ...m,
  href: monthHref(m.key),
  // Dated and not yet over. Undated rows are never past, so they would
  // otherwise count as "upcoming" when nothing says they are.
  count: eventsInMonth(m.key).filter((e) => e.start && !isPastDate(e.start, e.end, today)).length,
}));

// ── Towns ─────────────────────────────────────────────────────────────────
// Every town in the data, with its 2026 listing count. No town pages exist
// (city hubs are deferred — docs/CLAUDE.md), so these are plain text.
const townCounts = new Map<string, number>();
let countywide = 0;
for (const e of regionalEvents) {
  if (!e.city) {
    countywide++;
    continue;
  }
  townCounts.set(e.city, (townCounts.get(e.city) ?? 0) + 1);
}
const towns = [...townCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

// ── Types ─────────────────────────────────────────────────────────────────
// Categories in the data are free-text ("Halloween / Family"), so a type is a
// word match against them. Counts are 2026 listings.
const byCategory = (re: RegExp) => regionalEvents.filter((e) => re.test(e.category)).length;
const types: { label: string; count: string; links: { href: string; label: string }[]; note?: string }[] = [
  {
    label: "Free",
    count: `${totalFreeListings} Car Week listings`,
    links: [{ href: "/free/", label: "Free Car Week 2026 events" }],
    note: "Elsewhere an event is marked free only when its organiser says so.",
  },
  { label: "Family & kids", count: `${byCategory(/family/i)} listings`, links: [] },
  { label: "Festivals", count: `${byCategory(/festival/i)} listings`, links: [] },
  {
    label: "Car events",
    count: `${byCategory(/automotive|motorsport/i)} listings`,
    links: [
      { href: "/monterey-car-week/", label: "Monterey Car Week" },
      { href: "/monterey-car-week-map/", label: "venue map" },
      { href: "/laguna-seca-map/", label: "Laguna Seca map" },
    ],
  },
  {
    label: "Farmers markets",
    count: `${allMarkets.length} weekly markets`,
    links: [
      { href: "/monterey-farmers-market/", label: "Monterey County" },
      { href: "/santa-cruz-farmers-market/", label: "Santa Cruz County" },
    ],
  },
  { label: "Holidays", count: `${byCategory(/holiday|christmas|new year/i)} listings`, links: [] },
];

// ── Big annual events ─────────────────────────────────────────────────────
// One line each, written from the row's own fields. No 2027 date exists in the
// data for any of them except the Concours, so the rest read "2027 dates TBA".
const annualRow = (slug: string) => {
  const e = regionalEvents.find((x) => x.slug === slug);
  if (!e) throw new Error(`annual event "${slug}" missing from events-2026.ts`);
  return e;
};
const annual = [
  {
    e: annualRow("monterey-car-week"),
    line: "Ten days of concours, racing and auctions across Monterey, Carmel, Pebble Beach, Seaside and Salinas.",
    next: `Pebble Beach Concours ${CONCOURS_2027_TEXT}; full 2027 week TBA`,
  },
  {
    e: annualRow("monterey-county-fair"),
    line: "Five days over Labor Day weekend at the Monterey County Fair & Event Center.",
  },
  {
    e: annualRow("castroville-artichoke-festival"),
    line: "Back in Castroville in 2026, revived by the Castroville Coalition after the original festival closed in 2025.",
  },
  {
    e: annualRow("pacific-grove-butterfly-parade-bazaar"),
    line: "Pacific Grove's butterfly parade and community bazaar, one Saturday in early October.",
  },
  {
    e: annualRow("festa-italia-monterey"),
    line: "Monterey's Italian festival at Custom House Plaza — the 93rd in 2026.",
  },
  {
    e: annualRow("monterey-bay-greek-festival"),
    line: "Labor Day weekend, Saturday to Monday, at Custom House Plaza, by the organisers' recurring rule.",
  },
].map((a) => ({ ...a, href: eventHref(a.e), next: a.next ?? "2027 dates TBA" }));

// ── FAQ ───────────────────────────────────────────────────────────────────
// Rendered visibly AND emitted as FAQPage JSON-LD from this one array.
const townOf = (e: RegionalEvent) => e.city ?? "countywide";
const weekendAnswer = weekendIsEmpty
  ? upcoming.length
    ? `Nothing is listed for ${weekendLabel}. The next listed event is ${upcoming[0].name} in ${townOf(upcoming[0])}, ${upcoming[0].dateText}.`
    : `Nothing is listed for ${weekendLabel}, and no later dates are in the calendar yet.`
  : `${weekendEvents.length} listed for ${weekendLabel}: ${weekendEvents
      .map((e) => `${e.name} (${townOf(e)})`)
      .join("; ")}.${weekendMarkets.length ? ` ${weekendMarkets.length} farmers markets are also open.` : ""}`;
const freeUpcoming = upcoming.filter((e) => e.admission === "free").length;
const faq = [
  { q: "What's on around Monterey Bay this weekend?", a: weekendAnswer },
  {
    q: "When is Monterey Car Week 2027?",
    a: `The Pebble Beach Concours d'Elegance is on ${CONCOURS_2027_TEXT}. No organiser has published the dates of the full week yet, so we don't list any.`,
  },
  {
    q: "Where can I find free events?",
    a: `The free page lists the ${totalFreeListings} Car Week 2026 events that cost nothing to watch. On the rest of the calendar we mark an event free only when its organiser says so${
      freeUpcoming
        ? `; ${freeUpcoming} upcoming ${freeUpcoming === 1 ? "listing has" : "listings have"} that today.`
        : ", and no upcoming listing has that yet, so check the organiser link on each event page."
    }`,
  },
  {
    q: "How do I submit an event?",
    a: `Email ${SUBMIT_EMAIL} with the event name, date, town and a link to the organiser's page.`,
  },
  {
    q: "How are dates checked?",
    a: "Where an organiser publishes a date, theirs wins over every other listing, and we check that each weekday matches its date. An event with no announced date says \"Date not yet announced\" instead of a guess.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${site}/#organization`,
      name: "Monterey Bay Events",
      url: canonical,
      email: SUBMIT_EMAIL,
      areaServed: [
        { "@type": "AdministrativeArea", name: "Monterey County, California" },
        { "@type": "AdministrativeArea", name: "Santa Cruz County, California" },
      ],
    },
    {
      // No SearchAction: the site has no search.
      "@type": "WebSite",
      "@id": `${site}/#website`,
      url: canonical,
      name: "Monterey Bay Events",
      publisher: { "@id": `${site}/#organization` },
    },
    {
      "@type": "ItemList",
      name: "Upcoming events around Monterey Bay",
      numberOfItems: listedUpcoming.length,
      itemListElement: listedUpcoming.map((e, i) => ({
        "@type": "ListItem",
        position: i + 1,
        url: `${site}${eventHref(e)}`,
        name: e.name,
      })),
    },
    {
      "@type": "FAQPage",
      mainEntity: faq.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
  ],
};

const admissionLabel = (e: RegionalEvent) =>
  !e.admission ? null : e.admission === "free" ? "Free" : "Paid";
---

<BaseLayout>
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Monterey Bay Events" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={`${site}/og/home.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Monterey Bay Events — fairs, festivals and free things to do across Monterey and Santa Cruz counties" />

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site}/og/home.png`} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  </Fragment>

  <main>
    <FireAlert />

    <section class="border-b border-border/70">
      <div class="mx-auto max-w-6xl px-5 py-12 sm:py-16">
        <p class="eyebrow">Monterey &amp; Santa Cruz counties</p>
        <h1 class="mt-3 text-5xl leading-[0.9] sm:text-7xl">
          Monterey Bay <span class="text-brass">Events Calendar</span>
        </h1>
        <p class="mt-6 max-w-2xl text-base leading-relaxed text-muted-foreground">
          Public events across Monterey County and Santa Cruz County — festivals,
          fairs, parades, holiday markets, races and Monterey Car Week — each with
          its date, its town and a link to whoever runs it. Where an organiser
          publishes a date, theirs wins over every other listing; {withOrganiser} of
          the {upcoming.length} upcoming events link to their organiser's own site.
          Events with no announced date say so. Page regenerated {longDate(today)}.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a
            href="/events/"
            class="bg-brass px-6 py-3 text-xs font-bold uppercase tracking-[0.2em] text-primary-foreground transition-opacity hover:opacity-90"
          >
            All events
          </a>
          <a
            href="/monterey-events-calendar/"
            class="border border-brass px-6 py-3 text-xs font-bold uppercase tracking-[0.2em] text-brass transition-colors hover:bg-brass hover:text-primary-foreground"
          >
            Month-grid calendar
          </a>
        </div>
      </div>
    </section>

    <!-- This weekend -->
    <section id="this-weekend" class="mx-auto max-w-6xl px-5 py-12">
      <p class="eyebrow">{weekendLabel}</p>
      <h2 class="mt-2 text-4xl leading-none sm:text-5xl">
        {weekendIsEmpty ? "Nothing listed this weekend — next up" : "This weekend"}
      </h2>
      {
        weekendList.length ? (
          <ul class="mt-6 grid gap-2 sm:grid-cols-2">
            {weekendList.map((e) => (
              <li>
                <a
                  href={eventHref(e)}
                  class="group flex h-full flex-col gap-0.5 border-l-2 border-border/80 bg-surface/60 px-4 py-3 transition-colors hover:border-brass"
                >
                  <span class="text-lg leading-tight text-foreground transition-colors group-hover:text-brass">
                    {e.name}
                  </span>
                  <span class="text-sm text-muted-foreground">
                    <span class="text-brass">{e.dateText || DATE_TBA}</span> · {e.city ?? e.cityText}
                    {admissionLabel(e) && <> · {admissionLabel(e)}</>}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="mt-6 text-sm text-muted-foreground">
            No upcoming dates are in the calendar yet. The month pages below keep
            the full 2026 record.
          </p>
        )
      }
      {
        weekendMarkets.length > 0 && (
          <p class="mt-5 text-sm leading-relaxed text-muted-foreground">
            <span class="text-foreground">Farmers markets this weekend:</span>{" "}
            {weekendMarkets
              .map((s) => `${s.market.name} (${weekdayOf(s.date).slice(0, 3)} ${formatHours(s.hours)})`)
              .join(" · ")}
            .
          </p>
        )
      }
    </section>

    <!-- Next 30 days -->
    <section class="border-y border-border/70 bg-surface">
      <div class="mx-auto max-w-6xl px-5 py-12">
        <p class="eyebrow">Through {formatDay(horizon)}</p>
        <h2 class="mt-2 text-4xl leading-none sm:text-5xl">Coming up in the next 30 days</h2>
        {
          nextThirty.length === 0 && (
            <p class="mt-6 text-sm text-muted-foreground">Nothing else is listed in the next 30 days.</p>
          )
        }
        <ul class="mt-6 divide-y divide-border/70">
          {
            [...nextThirty, ...furtherAhead].map((e, i) => (
              <>
                {i === nextThirty.length && furtherAhead.length > 0 && (
                  <li class="pt-5 pb-2 text-[0.65rem] font-bold uppercase tracking-[0.18em] text-muted-foreground">
                    Further ahead
                  </li>
                )}
                <li>
                  <a href={eventHref(e)} class="group flex flex-wrap items-baseline gap-x-3 py-2.5">
                    <span class="w-full text-[0.65rem] font-semibold uppercase tracking-[0.16em] text-brass sm:w-44">
                      {e.dateText || DATE_TBA}
                    </span>
                    <span class="text-base text-foreground transition-colors group-hover:text-brass">{e.name}</span>
                    <span class="text-sm text-muted-foreground">
                      {e.city ?? e.cityText}
                      {admissionLabel(e) && <> · {admissionLabel(e)}</>}
                    </span>
                  </a>
                </li>
              </>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Browse -->
    <section class="mx-auto max-w-6xl px-5 py-12">
      <div class="grid gap-10 md:grid-cols-3">
        <div>
          <h2 class="text-3xl leading-none">Browse by month</h2>
          <ul class="mt-4 space-y-2">
            {
              monthLinks.map((m) => (
                <li>
                  <a href={m.href} class="text-brass hover:underline">{m.label}</a>
                  <span class="text-sm text-muted-foreground"> · {m.count} upcoming</span>
                </li>
              ))
            }
          </ul>
          <p class="mt-3 text-sm text-muted-foreground">
            Or every month at once on the{" "}
            <a href="/events/" class="text-brass hover:underline">full event list</a>.
          </p>
        </div>

        <div>
          <h2 class="text-3xl leading-none">Browse by town</h2>
          <p class="mt-2 text-xs uppercase tracking-[0.16em] text-muted-foreground">2026 listings</p>
          <ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-1 text-sm">
            {
              towns.map(([town, n]) => (
                <li class="text-foreground">
                  {town} <span class="text-muted-foreground">{n}</span>
                </li>
              ))
            }
            {countywide > 0 && (
              <li class="text-foreground">
                Countywide <span class="text-muted-foreground">{countywide}</span>
              </li>
            )}
          </ul>
        </div>

        <div>
          <h2 class="text-3xl leading-none">Browse by type</h2>
          <ul class="mt-4 space-y-2.5 text-sm">
            {
              types.map((t) => (
                <li>
                  <span class="text-foreground">{t.label}</span>
                  <span class="text-muted-foreground"> · {t.count}</span>
                  {t.links.length > 0 && (
                    <span>
                      {" — "}
                      {t.links.map((l, i) => (
                        <>
                          {i > 0 && ", "}
                          <a href={l.href} class="text-brass hover:underline">{l.label}</a>
                        </>
                      ))}
                    </span>
                  )}
                  {t.note && <span class="block text-muted-foreground">{t.note}</span>}
                </li>
              ))
            }
          </ul>
          <p class="mt-3 text-sm text-muted-foreground">
            Driving in? <a href="/traffic/" class="text-brass hover:underline">Closures and traffic</a>.
          </p>
        </div>
      </div>
    </section>

    <!-- Big annual events -->
    <section class="border-y border-border/70 bg-surface">
      <div class="mx-auto max-w-6xl px-5 py-12">
        <h2 class="text-4xl leading-none sm:text-5xl">Big annual events</h2>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2">
          {
            annual.map((a) => (
              <li class="border-l-2 border-border/80 bg-background px-4 py-3">
                <a href={a.href} class="text-lg leading-tight text-foreground hover:text-brass">
                  {a.e.name.replace(/ \(.*\)$/, "")}
                </a>
                <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{a.line}</p>
                <p class="mt-1 text-[0.65rem] font-semibold uppercase tracking-[0.16em] text-brass">
                  2026: {a.e.dateText || DATE_TBA} · {a.next}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- FAQ -->
    <section class="mx-auto max-w-3xl px-5 py-12">
      <h2 class="text-4xl leading-none sm:text-5xl">Questions</h2>
      <dl class="mt-6 space-y-5">
        {
          faq.map((f) => (
            <div>
              <dt class="text-lg text-foreground">{f.q}</dt>
              <dd class="mt-1 text-sm leading-relaxed text-muted-foreground">{f.a}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- Submit -->
    <section class="mx-auto max-w-6xl px-5 pb-16">
      <div class="border-l-2 border-brass bg-surface/60 px-6 py-7">
        <h2 class="text-3xl leading-none">Submit an event</h2>
        <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted-foreground">
          Running a public event in Monterey or Santa Cruz County that isn't here?
          Send the name, date, town and a link to your own page.
        </p>
        <a
          href={`mailto:${SUBMIT_EMAIL}?subject=Event%20submission`}
          class="mt-5 inline-block bg-brass px-6 py-3 text-xs font-bold uppercase tracking-[0.2em] text-primary-foreground transition-opacity hover:opacity-90"
        >
          Email {SUBMIT_EMAIL}
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
