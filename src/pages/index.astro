---
// src/pages/index.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import EventCard from "../components/EventCard.tsx";
import { ROAD_CLOSURES_URL, schedule, totalEvents } from "../data/events";

const site = "https://montereybayevents.com";
const title = "Monterey Car Week 2026 — Schedule, Traffic & Events";
const description =
  "Every Monterey Car Week 2026 event from August 7–16: concours, auctions, rallies and races, with road closure and public safety information.";
// Canonical MUST match the served URL incl. trailing slash (trailingSlash:
// 'always' in astro.config.mjs). For a sub-page, derive it the same way:
//   const canonical = `${site}/<route>/`;   // e.g. `${site}/about/`
// A no-slash canonical 308-redirects and breaks indexing (CHECK_161).
const canonical = `${site}/`;

const highlightTitles = [
  "Pebble Beach Concours d'Elegance",
  "The Quail, A Motorsports Gathering",
  "Rolex Monterey Motorsports Reunion",
  "Monterey Pre-Reunion and Corkscrew Hillclimb",
];

const highlights = highlightTitles
  .map((t) => schedule.flatMap((d) => d.events).find((e) => e.title === t))
  .filter((e): e is NonNullable<typeof e> => Boolean(e));

const stats = [
  { n: "10", l: "Days" },
  { n: String(totalEvents), l: "Listed events" },
  { n: "75th", l: "Pebble Beach Concours" },
  { n: "Free", l: "Public safety texts" },
];
---

<BaseLayout>
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Monterey Bay Events" />
    <meta property="og:image" content={`${site}/og-carweek.jpg`} />

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site}/og-carweek.jpg`} />

    <!-- JSON-LD structured data: Organization + WebSite + the Car Week Event
         itself (static; domain is known at scaffold time). -->
    <script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://montereybayevents.com/#organization",
      "name": "Monterey Bay Events",
      "url": "https://montereybayevents.com/"
    },
    {
      "@type": "WebSite",
      "@id": "https://montereybayevents.com/#website",
      "url": "https://montereybayevents.com/",
      "name": "Monterey Bay Events",
      "publisher": { "@id": "https://montereybayevents.com/#organization" }
    },
    {
      "@type": "Event",
      "name": "Monterey Car Week 2026",
      "startDate": "2026-08-07",
      "endDate": "2026-08-16",
      "eventStatus": "https://schema.org/EventScheduled",
      "url": "https://montereybayevents.com/",
      "location": {
        "@type": "Place",
        "name": "Monterey Peninsula",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Monterey",
          "addressRegion": "CA",
          "addressCountry": "US"
        }
      },
      "organizer": {
        "@type": "Organization",
        "name": "Monterey Bay Events",
        "url": "https://montereybayevents.com/"
      }
    }
  ]
}
    </script>
  </Fragment>

  <main>
    <section class="relative">
      <img
        src="/hero-carweek.jpg"
        alt="A silver 1950s Porsche racing car on a coastal Monterey road at golden hour"
        width={1920}
        height={1088}
        class="h-[68vh] min-h-[420px] w-full object-cover"
      />
      <div class="hero-scrim absolute inset-0"></div>
      <div class="absolute inset-0 flex items-end">
        <div class="mx-auto w-full max-w-6xl px-5 pb-10">
          <p class="eyebrow">August 7 – 16, 2026 · Monterey Peninsula</p>
          <h1 class="mt-3 text-6xl leading-[0.85] sm:text-8xl md:text-[9rem]">
            Monterey
            <br />
            <span class="text-brass">Car Week</span> 2026
          </h1>
          <p class="mt-5 max-w-xl text-base leading-relaxed text-muted-foreground">
            Ten days, {totalEvents} listed events, one peninsula. Concours lawns,
            historic racing, auctions and dawn drives along Highway One.
          </p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a
              href="/schedule/"
              class="bg-brass px-6 py-3 text-xs font-bold uppercase tracking-[0.2em] text-primary-foreground transition-opacity hover:opacity-90"
            >
              View the schedule
            </a>
            <a
              href="/traffic/"
              class="border border-border px-6 py-3 text-xs font-bold uppercase tracking-[0.2em] text-foreground transition-colors hover:border-brass hover:text-brass"
            >
              Traffic &amp; safety
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="border-y border-border/70 bg-surface">
      <div class="mx-auto grid max-w-6xl grid-cols-2 gap-px px-5 py-8 sm:grid-cols-4">
        {
          stats.map((s) => (
            <div>
              <p class="font-display text-4xl leading-none text-brass">{s.n}</p>
              <p class="mt-1 text-xs uppercase tracking-[0.16em] text-muted-foreground">
                {s.l}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-5 py-16">
      <p class="eyebrow">Marquee events</p>
      <h2 class="mt-2 text-5xl leading-none sm:text-6xl">The ones to plan around</h2>
      <div class="mt-8 grid gap-3 md:grid-cols-2">
        {highlights.map((e) => <EventCard event={e} />)}
      </div>
    </section>

    <section class="border-t border-border/70 bg-surface">
      <div class="mx-auto max-w-6xl px-5 py-16">
        <p class="eyebrow">Day by day</p>
        <h2 class="mt-2 text-5xl leading-none sm:text-6xl">Ten days on the peninsula</h2>
        <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
          {
            schedule.map((day) => (
              <a
                href={`/schedule/#${day.id}`}
                class="group border border-border/80 bg-background px-4 py-5 transition-colors hover:border-brass"
              >
                <p class="text-xs uppercase tracking-[0.18em] text-muted-foreground">
                  {day.weekday}
                </p>
                <p class="mt-1 font-display text-3xl leading-none text-foreground transition-colors group-hover:text-brass">
                  {day.short}
                </p>
                <p class="mt-2 text-sm text-muted-foreground">{day.events.length} events</p>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-5 py-16">
      <div class="border-l-2 border-brass bg-surface/60 px-6 py-8">
        <p class="eyebrow">Before you drive</p>
        <h2 class="mt-2 text-4xl leading-none">Expect heavy traffic all week</h2>
        <p class="mt-4 max-w-2xl text-sm leading-relaxed text-muted-foreground">
          Highway One, Ocean Avenue and the routes into Pebble Beach and Laguna Seca
          slow to a crawl during peak event hours. Check live closures before every
          trip, and text <span class="text-brass">CARWEEK</span> to{" "}
          <span class="text-brass">65513</span> for public safety alerts.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href={ROAD_CLOSURES_URL}
            target="_blank"
            rel="noreferrer"
            class="bg-brass px-6 py-3 text-xs font-bold uppercase tracking-[0.2em] text-primary-foreground transition-opacity hover:opacity-90"
          >
            Live road closures
          </a>
          <a
            href="/traffic/"
            class="border border-border px-6 py-3 text-xs font-bold uppercase tracking-[0.2em] text-foreground transition-colors hover:border-brass hover:text-brass"
          >
            All traffic info
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
