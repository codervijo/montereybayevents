---
// src/pages/index.astro — the Monterey Bay events index.
//
// Site-level page: Organization + WebSite JSON-LD live here, and Car Week is the
// featured section rather than the subject of the whole page. The Car Week hub
// (with its own Event JSON-LD) is at /monterey-car-week/.
//
// SCOPE NOTE: two datasets back this page. Monterey Car Week 2026 in full
// (src/data/events.ts), and the regional Aug–Dec 2026 calendar sourced from
// data/monterey_santacruz_events_aug_dec_2026.csv (src/data/events-2026.ts).
// Nothing on this page is invented: an event with no announced date is listed
// as "date not yet announced" rather than given a plausible one.
import BaseLayout from "../layouts/BaseLayout.astro";
import FireAlert from "../components/FireAlert.astro";
import { ROAD_CLOSURES_URL, schedule, totalEvents } from "../data/events";
import { totalFreeListings } from "../data/eventIndex";
import {
  DATE_TBA,
  currentAndNextMonth,
  eventHref,
  eventsInMonth,
  monthHref,
  regionalEvents,
  totalRegionalEvents,
} from "../data/events-2026";
import { isPastDate } from "../lib/isPast";

const site = "https://montereybayevents.com";
// Title is kept at or under 60 chars and description within 120-160 so neither
// is truncated in a SERP (CHECK_070 / CHECK_071). `description` is written to
// land in range as-is — do NOT reintroduce a `.slice()` here: the old
// `description.slice(0, 155)` cut mid-word, shipping "…plus Monte" to search
// results, and it also defeated the conformance checker's Astro head resolver,
// which cannot parse a method call with arguments and read the literal string
// "{description.slice(0," as a 21-character description.
//
// The literal is also kept short enough that it stays inside 120-160 BOTH as
// rendered (`${totalRegionalEvents}` -> "61", 129 chars) and as raw source with
// the placeholder unexpanded (149 chars) — that checker measures the source and
// does not evaluate template interpolation. Adding ~20 chars here passes in the
// browser but trips CHECK_071 at 161+.
const title = "Monterey Bay Events — Monterey & Santa Cruz Event Calendar";
const description = `Monterey and Santa Cruz county events: ${totalRegionalEvents} public events, August to December 2026, with verified dates, cities and official links.`;

// The month hubs to feature, resolved from the build date and clamped to the
// months the dataset covers — see currentAndNextMonth().
// Car Week 2026 ran 7-16 August. Everything below that leans on it is written
// in both tenses, so the homepage stops leading with a finished event the day
// after it ends rather than whenever someone notices.
const carWeekIsPast = isPastDate("2026-08-07", "2026-08-16");

const { current, next } = currentAndNextMonth(new Date());
const featuredMonths = [current, ...(next ? [next] : [])].map((m) => ({
  ...m,
  href: monthHref(m.key),
  // Past events are dropped from the homepage. It is a decision surface —
  // nobody arrives at "what's on" wanting to know what they missed. The month
  // hubs still list everything, marked, because their job is the full record.
  // NOTE: this is build-time (see src/lib/isPast.ts) — it is only correct while
  // the site is rebuilt regularly. See v1.Q in docs/prd.md.
  events: eventsInMonth(m.key).filter((e) => !isPastDate(e.start, e.end)).slice(0, 5),
  count: eventsInMonth(m.key).filter((e) => !isPastDate(e.start, e.end)).length,
}));
// Canonical MUST match the served URL incl. trailing slash (trailingSlash:
// 'always' in astro.config.mjs). For a sub-page, derive it the same way:
//   const canonical = `${site}/<route>/`;   // e.g. `${site}/free/`
// A no-slash canonical 308-redirects and breaks indexing (CHECK_161).
// The next things actually happening, for the featured slot once Car Week has
// been and gone. Undated rows are excluded — they cannot be "next".
const upcomingEvents = regionalEvents
  .filter((e) => e.start && !isPastDate(e.start, e.end) && !e.existingSlug && !e.hubHref)
  .sort((a, b) => (a.start! < b.start! ? -1 : 1))
  .slice(0, 4);

const canonical = `${site}/`;

// Sections of the site that exist today, in the order a visitor needs them.
const sections = [
  {
    href: "/events/",
    label: "The 2026 calendar",
    body: `All ${totalRegionalEvents} Central Coast events, August to December, by county and month.`,
  },
  ...(carWeekIsPast
    ? [
        {
          href: monthHref(current.key),
          label: `What's on in ${current.label.split(" ")[0]}`,
          body: "Every listed event this month, by county, with dates and official links.",
        },
        {
          href: "/monterey-car-week/",
          label: "Monterey Car Week 2026",
          body: `The full ${totalEvents}-listing record of August 7-16, kept for reference.`,
        },
      ]
    : [
        {
          href: "/monterey-car-week/schedule/",
          label: "Full Car Week schedule",
          body: `All ${totalEvents} listings across ten days, filterable by admission.`,
        },
        {
          href: "/free/",
          label: "Free Car Week events",
          body: `${totalFreeListings} listings that cost nothing to spectate, grouped by day.`,
        },
      ]),
  {
    href: "/traffic/",
    label: "Traffic, closures & safety",
    body: "Live county closures, Caltrans cameras and public safety text alerts.",
  },
];
---

<BaseLayout>
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Monterey Bay Events" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={`${site}/og-carweek.jpg`} />

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site}/og-carweek.jpg`} />

    <!-- Site-level JSON-LD. The Monterey Car Week Event object lives on its own
         hub page (/monterey-car-week/), not here. -->
    <script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://montereybayevents.com/#organization",
      "name": "Monterey Bay Events",
      "url": "https://montereybayevents.com/",
      "areaServed": [
        { "@type": "AdministrativeArea", "name": "Monterey County, California" },
        { "@type": "AdministrativeArea", "name": "Santa Cruz County, California" }
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://montereybayevents.com/#website",
      "url": "https://montereybayevents.com/",
      "name": "Monterey Bay Events",
      "publisher": { "@id": "https://montereybayevents.com/#organization" }
    }
  ]
}
    </script>
  </Fragment>

  <main>
    <FireAlert />

    <section class="border-b border-border/70">
      <div class="mx-auto max-w-6xl px-5 py-14 sm:py-20">
        <p class="eyebrow">Monterey &amp; Santa Cruz counties</p>
        <h1 class="mt-3 text-5xl leading-[0.88] sm:text-7xl md:text-8xl">
          What's on around
          <br />
          <span class="text-brass">Monterey Bay</span>
        </h1>
        <p class="mt-6 max-w-2xl text-base leading-relaxed text-muted-foreground">
          Verified dates, locations and free-or-ticketed status for public events
          across the Central Coast — the details that official calendars bury.
          {totalRegionalEvents} events from August to December 2026, county fairs
          to holiday markets{carWeekIsPast ? "." : ", plus Monterey Car Week covered day by day."}
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="/events/"
            class="bg-brass px-6 py-3 text-xs font-bold uppercase tracking-[0.2em] text-primary-foreground transition-opacity hover:opacity-90"
          >
            All 2026 events
          </a>
          <a
            href="/monterey-car-week/"
            class="border border-brass px-6 py-3 text-xs font-bold uppercase tracking-[0.2em] text-brass transition-colors hover:bg-brass hover:text-primary-foreground"
          >
            Monterey Car Week 2026
          </a>
          <a
            href={carWeekIsPast ? monthHref(current.key) : "/free/"}
            class="border border-brass px-6 py-3 text-xs font-bold uppercase tracking-[0.2em] text-brass transition-colors hover:bg-brass hover:text-primary-foreground"
          >
            {carWeekIsPast ? current.label : "Free Car Week events"}
          </a>
        </div>
      </div>
    </section>

    {
      /* Featured slot. While Car Week is ahead it is the story; once it is past
         the slot goes to what is actually next, rather than leaving a finished
         event with a photograph at the top of the page. */
    }
    {
      carWeekIsPast ? (
        <section class="mx-auto max-w-6xl px-5 py-14">
          <p class="eyebrow">Coming up</p>
          <h2 class="mt-2 text-4xl leading-none sm:text-5xl">Next on the Central Coast</h2>
          <div class="mt-8 grid gap-3 sm:grid-cols-2">
            {upcomingEvents.map((e) => (
              <a
                href={eventHref(e)}
                class="group flex flex-col gap-1 border-l-2 border-border/80 bg-surface/60 px-5 py-4 transition-colors hover:border-brass"
              >
                <span class="text-[0.65rem] font-semibold uppercase tracking-[0.18em] text-brass">
                  {e.dateText || DATE_TBA}
                </span>
                <span class="text-xl leading-tight text-foreground transition-colors group-hover:text-brass">
                  {e.name}
                </span>
                <span class="text-sm text-muted-foreground">
                  {e.city ?? e.cityText}, {e.county} County
                </span>
              </a>
            ))}
          </div>
          <a
            href="/events/"
            class="mt-7 inline-block bg-brass px-6 py-3 text-xs font-bold uppercase tracking-[0.2em] text-primary-foreground transition-opacity hover:opacity-90"
          >
            All 2026 events
          </a>
        </section>
      ) : (
    <section class="mx-auto max-w-6xl px-5 py-14">
      <p class="eyebrow">Featured event</p>
      <div class="mt-4 overflow-hidden border border-border/80 bg-surface">
        <a href="/monterey-car-week/" class="group block">
          <img
            src="/hero-carweek.jpg"
            alt="A silver 1950s Porsche racing car on a coastal Monterey road at golden hour"
            width={1920}
            height={1088}
            class="h-64 w-full object-cover sm:h-80"
          />
        </a>
        <div class="px-6 py-8 sm:px-8">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-muted-foreground">
            August 7 – 16, 2026 · Monterey Peninsula
          </p>
          <h2 class="mt-3 text-4xl leading-none sm:text-6xl">
            <a href="/monterey-car-week/" class="transition-colors hover:text-brass">
              Monterey <span class="text-brass">Car Week</span> 2026
            </a>
          </h2>
          <p class="mt-5 max-w-2xl text-base leading-relaxed text-muted-foreground">
            Ten days, {totalEvents} listed events across the peninsula — concours
            lawns, historic racing at Laguna Seca, auctions and dawn drives on
            Highway One. {totalFreeListings} of them are free for spectators.
          </p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a
              href="/monterey-car-week/"
              class="bg-brass px-5 py-2.5 text-xs font-bold uppercase tracking-[0.18em] text-primary-foreground transition-opacity hover:opacity-90"
            >
              Car Week overview
            </a>
            <a
              href="/monterey-car-week/schedule/"
              class="border border-border px-5 py-2.5 text-xs font-bold uppercase tracking-[0.18em] text-foreground transition-colors hover:border-brass hover:text-brass"
            >
              Day-by-day schedule
            </a>
            <a
              href="/free/"
              class="border border-border px-5 py-2.5 text-xs font-bold uppercase tracking-[0.18em] text-foreground transition-colors hover:border-brass hover:text-brass"
            >
              Free events
            </a>
          </div>

          <div class="mt-8 grid gap-2 border-t border-border/70 pt-6 sm:grid-cols-5">
            {
              schedule.map((day) => (
                <a
                  href={`/monterey-car-week/schedule/#${day.id}`}
                  class="group border border-border/70 bg-background px-3 py-3 transition-colors hover:border-brass"
                >
                  <p class="text-[0.6rem] uppercase tracking-[0.18em] text-muted-foreground">
                    {day.weekday}
                  </p>
                  <p class="mt-0.5 font-display text-2xl leading-none text-foreground transition-colors group-hover:text-brass">
                    {day.short}
                  </p>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </section>
      )
    }

    <!-- Site sections -->
    <section class="border-y border-border/70 bg-surface">
      <div class="mx-auto max-w-6xl px-5 py-14">
        <p class="eyebrow">Start here</p>
        <h2 class="mt-2 text-4xl leading-none sm:text-5xl">Plan the week</h2>
        <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {
            sections.map((s) => (
              <a
                href={s.href}
                class="group flex flex-col gap-2 border-l-2 border-border/80 bg-background px-5 py-5 transition-all hover:border-brass"
              >
                <h3 class="text-xl leading-tight text-foreground transition-colors group-hover:text-brass">
                  {s.label}
                </h3>
                <p class="text-sm leading-relaxed text-muted-foreground">{s.body}</p>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- What's on now and next, straight from the 2026 dataset -->
    <section class="mx-auto max-w-6xl px-5 py-14">
      <p class="eyebrow">Also on the Central Coast calendar</p>
      <h2 class="mt-2 text-4xl leading-none sm:text-5xl">On now and next</h2>
      <p class="mt-5 max-w-2xl text-sm leading-relaxed text-muted-foreground">
        County fairs, festivals, parades and holiday markets across both counties.
        Dates are the organizer's published dates — where a 2026 date has not been
        announced, the listing says so instead of guessing.
      </p>

      <div class="mt-8 grid gap-8 sm:grid-cols-2">
        {
          featuredMonths.map((m) => (
            <div>
              <div class="flex flex-wrap items-end gap-x-3 border-b border-border/70 pb-2">
                <h3 class="text-3xl leading-none text-brass">
                  <a href={m.href} class="hover:underline">
                    {m.label}
                  </a>
                </h3>
                <span class="pb-0.5 text-[0.65rem] font-semibold uppercase tracking-[0.18em] text-muted-foreground">
                  {m.count} events
                </span>
              </div>
              <ul class="mt-4 space-y-2">
                {m.events.map((e) => (
                  <li>
                    <a
                      href={eventHref(e)}
                      class="group flex flex-wrap items-baseline gap-x-3 border-l-2 border-border/80 bg-surface/60 px-4 py-2.5 transition-colors hover:border-brass"
                    >
                      <span class="text-base text-foreground transition-colors group-hover:text-brass">
                        {e.name}
                      </span>
                      <span
                        class={`text-[0.6rem] font-semibold uppercase tracking-[0.16em] ${
                          e.start ? "text-brass" : "text-muted-foreground"
                        }`}
                      >
                        {e.dateText || DATE_TBA}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
              <a
                href={m.href}
                class="mt-4 inline-block text-[0.65rem] font-bold uppercase tracking-[0.18em] text-muted-foreground hover:text-brass"
              >
                All {m.label} events →
              </a>
            </div>
          ))
        }
      </div>

      <a
        href="/events/"
        class="mt-10 inline-block border border-brass px-6 py-3 text-xs font-bold uppercase tracking-[0.2em] text-brass transition-colors hover:bg-brass hover:text-primary-foreground"
      >
        The full 2026 calendar
      </a>
    </section>

    <section class="mx-auto max-w-6xl px-5 pb-16">
      <div class="border-l-2 border-brass bg-surface/60 px-6 py-8">
        <p class="eyebrow">Before you drive</p>
        <h2 class="mt-2 text-4xl leading-none">{carWeekIsPast ? "Check the road before you go" : "Peninsula traffic peaks in August"}</h2>
        <p class="mt-4 max-w-2xl text-sm leading-relaxed text-muted-foreground">
          {
            carWeekIsPast ? (
              <Fragment>
                Highway 1 through Big Sur is closed by the Timber Fire, and event
                traffic still reshapes Ocean Avenue and the routes into Pebble
                Beach and Laguna Seca. Check live closures before every trip.
              </Fragment>
            ) : (
              <Fragment>
                Highway One, Ocean Avenue and the routes into Pebble Beach and
                Laguna Seca slow to a crawl during Car Week event hours. Check
                live closures before every trip, and text{" "}
                <span class="text-brass">CARWEEK</span> to{" "}
                <span class="text-brass">65513</span> for public safety alerts.
              </Fragment>
            )
          }
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href={ROAD_CLOSURES_URL}
            target="_blank"
            rel="noreferrer"
            class="bg-brass px-6 py-3 text-xs font-bold uppercase tracking-[0.2em] text-primary-foreground transition-opacity hover:opacity-90"
          >
            Live road closures
          </a>
          <a
            href="/traffic/"
            class="border border-border px-6 py-3 text-xs font-bold uppercase tracking-[0.2em] text-foreground transition-colors hover:border-brass hover:text-brass"
          >
            All traffic info
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
