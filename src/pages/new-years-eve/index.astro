---
// /new-years-eve/ — hub for New Year's Eve 2026 (v2.U, 2026-11-25).
// Links down to the two town pages; listings from data/nye-2026.json.
import BaseLayout from "../../layouts/BaseLayout.astro";
import NyeListings from "../../components/NyeListings.astro";
import { forRegion, nye, nyeHref, eventJsonLd, NYD_DATE, NYE_PAGES } from "../../data/nye";

const site = "https://montereybayevents.com";
const canonical = `${site}${NYE_PAGES.hub}`;
const monterey = forRegion("monterey");
const santaCruz = forRegion("santa-cruz");
const family = nye.filter((e) => e.tags.includes("family") || e.free);
const newYearsDay = nye.filter((e) => e.date === NYD_DATE);

const title = "New Year's Eve 2026 in Monterey & Santa Cruz";
const description =
  "Where to spend New Year's Eve 2026 around Monterey Bay: First Night Monterey, hotel parties, Santa Cruz shows and dinners, and what's open on New Year's Day.";
const image = `${site}/og/nye.png`;

const faq = [
  { q: "Are there New Year's Eve fireworks in Monterey or Santa Cruz?", a: "No. We found no permitted New Year's Eve fireworks show in Monterey or Santa Cruz County for 2026. First Night Monterey ends with an indoor countdown from 11:15pm, Monterey police say fireworks are illegal in the city, and the City of Santa Cruz and unincorporated Santa Cruz County ban all fireworks." },
  { q: "What's the biggest New Year's Eve event around Monterey Bay?", a: "First Night Monterey: an alcohol-free arts festival across downtown Monterey from 3pm to midnight on 31 December, with 50+ performances on one button ($30–35 adults, $15–20 ages 6–15, under-6s free). In Santa Cruz, the Catalyst's party (16+, 7:30pm to 1am) is the largest." },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "New Year's Eve 2026 around Monterey Bay",
    url: canonical,
    numberOfItems: nye.length,
    itemListElement: nye.map((e, i) => ({ "@type": "ListItem", position: i + 1, name: e.name, url: `${site}${nyeHref(e)}` })),
  },
  ...family.map((e) => eventJsonLd(e, site)),
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${site}/` },
      { "@type": "ListItem", position: 2, name: "New Year's Eve", item: canonical },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
];

const h2 = "border-b border-border/70 pb-2 text-3xl text-brass";
const para = "mt-4 max-w-3xl text-base leading-relaxed text-muted-foreground";
const link = "text-brass hover:underline";
const big = "block border-l-2 border-brass bg-surface/60 px-6 py-6 transition-colors hover:bg-surface";
---

<BaseLayout>
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Monterey Bay Events" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="New Year's Eve 2026 in Monterey and Santa Cruz" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {jsonLd.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
  </Fragment>

  <main class="mx-auto max-w-4xl px-5 py-14">
    <nav aria-label="Breadcrumb" class="text-[0.65rem] font-bold uppercase tracking-[0.2em] text-muted-foreground">
      <a href="/" class="hover:text-brass">Home</a>
      <span aria-hidden="true"> / </span>
      <span class="text-foreground">New Year's Eve</span>
    </nav>

    <p class="eyebrow mt-6">Thursday 31 December 2026 – Friday 1 January 2027</p>
    <h1 class="mt-2 text-5xl leading-[0.88] sm:text-7xl">
      New Year's Eve on <span class="text-brass">Monterey Bay</span>
    </h1>
    <p class="mt-6 max-w-3xl text-lg leading-relaxed text-muted-foreground">
      The two halves of the bay do New Year's differently. Monterey's night is
      First Night, an alcohol-free arts festival across downtown from 3pm to
      midnight, with hotel parties for the 21-and-over crowd. Santa Cruz's is
      live music: the Catalyst, the Vets Hall, Moe's Alley and Chaminade. Neither
      has fireworks.
    </p>
    <p class={para}>
      We list an event only once its organiser has confirmed it for 2026, and we
      re-check every listing on 15 and 28 December, as hotels and venues post late.
    </p>

    <div class="mt-10 grid gap-4 sm:grid-cols-2">
      <a href={NYE_PAGES.monterey} class={big}>
        <p class="text-[0.6rem] font-bold uppercase tracking-[0.2em] text-muted-foreground">Monterey, Carmel, PG, Seaside, Salinas · {monterey.length} events</p>
        <p class="mt-2 text-3xl leading-tight text-brass">New Year's Eve in Monterey →</p>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">First Night Monterey, the Portola's Countdown Club, the Dirty Dozen Brass Band and a Carmel tribute bash.</p>
      </a>
      <a href={NYE_PAGES["santa-cruz"]} class={big}>
        <p class="text-[0.6rem] font-bold uppercase tracking-[0.2em] text-muted-foreground">Santa Cruz, Capitola, Aptos · {santaCruz.length} events</p>
        <p class="mt-2 text-3xl leading-tight text-brass">New Year's Eve in Santa Cruz →</p>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">The Catalyst, China Cats at the Vets Hall, Moe's Alley, Chaminade and Shadowbrook.</p>
      </a>
    </div>

    <section class="mt-14" id="free-family">
      <h2 class={h2}>Free &amp; family</h2>
      <p class={para}>
        No free New Year's Eve countdown is confirmed for 2026 on either side of
        the bay, and the libraries' and museums' Noon Year's events have not been
        announced yet. What is confirmed:
      </p>
      <NyeListings entries={family} id="family" />
      <p class={para}>
        Also free and open into New Year's: Christmas on the Wharf in Monterey
        (decorated daily to 3 January), Farley's Christmas Wonderland in Santa Cruz
        (5:30–8:30pm to 1 January; the family asks for donations), and free entry
        to the Boardwalk's Winter Wonderland on the days it opens. All of them are
        on the <a href="/holiday-lights/" class={link}>holiday lights map</a>. Ice
        Skating by the Bay in Monterey is open 12pm to 8pm on both days.
      </p>
    </section>

    <section class="mt-14" id="new-years-day">
      <h2 class={h2}>New Year's Day</h2>
      <NyeListings entries={newYearsDay} id="nyd" />
      <p class={para}>
        The Monterey rink opens 12pm to 8pm, and Farley's lights have their last
        night. California State Parks has announced First Day Hikes for 1 January
        2027, but no hike in either county was listed when we checked on 25
        November. No New Year's Day polar plunge is confirmed either; Santa Cruz's
        is in March.
      </p>
    </section>

    <section class="mt-14 max-w-3xl">
      <h2 class={h2}>Common questions</h2>
      <dl class="mt-6 space-y-6">
        {faq.map((f) => (
          <div>
            <dt class="text-lg font-semibold text-foreground">{f.q}</dt>
            <dd class="mt-2 text-base leading-relaxed text-muted-foreground">{f.a}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="mt-16 border-t border-border/70 pt-8">
      <h2 class="text-2xl text-brass">More around the holidays</h2>
      <div class="mt-4 grid gap-2 sm:grid-cols-2">
        <a href="/holiday-lights/" class="border-l-2 border-border/80 bg-surface/60 px-4 py-3 text-sm text-foreground transition-colors hover:border-brass hover:text-brass">Holiday lights map 2026</a>
        <a href="/event/first-night-monterey/" class="border-l-2 border-border/80 bg-surface/60 px-4 py-3 text-sm text-foreground transition-colors hover:border-brass hover:text-brass">First Night Monterey</a>
        <a href="/events/december/" class="border-l-2 border-border/80 bg-surface/60 px-4 py-3 text-sm text-foreground transition-colors hover:border-brass hover:text-brass">December events on the Central Coast</a>
        <a href="/thanksgiving/" class="border-l-2 border-border/80 bg-surface/60 px-4 py-3 text-sm text-foreground transition-colors hover:border-brass hover:text-brass">Thanksgiving weekend, day by day</a>
      </div>
    </section>
  </main>
</BaseLayout>
