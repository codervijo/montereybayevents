---
// Every farmers market in Monterey County that its operator confirms is
// running, Monterey Peninsula first — rendered by FarmersMarketPage. Data and
// all date logic: src/data/farmersMarkets.ts.
//
// Live since v2.I as a City of Monterey page; widened to the county in v2.J.
// The URL and H1 are unchanged. The title moved to the county form while the
// page was hours old and not yet indexed.
import FarmersMarketPage from "../components/FarmersMarketPage.astro";
import { pacificToday } from "../lib/isPast";
import {
  FALL_PRODUCE,
  NEARBY_YEAR_ROUND,
  PET_RULE,
  formatHours,
  inSeason,
  montereyCountyMarkets as markets,
  montereySkipped,
  openTodayLine,
  sessionsOn,
} from "../data/farmersMarkets";
import { MONTHS, monthHref } from "../data/events-2026";

const today = pacificToday();
const place = "Monterey County";
const areas = ["Monterey Peninsula", "Carmel", "Salinas", "North County", "Salinas Valley"];
const ordered = [...markets].sort((a, b) => areas.indexOf(a.area) - areas.indexOf(b.area));
const byId = Object.fromEntries(markets.map((m) => [m.id, m]));
const hrs = (id: string) => formatHours(byId[id].hours[0]);

const friday = byId["monterey-friday"];
const fridayVendorCount = friday.vendors?.length ?? 0;
const fridayOrganic = (friday.vendors ?? []).filter((x) => x.production === "Organic").length;
const fridayMakers = (friday.vendors ?? []).filter((x) => x.production === "N/A").length;
const alisalInSeason = inSeason(byId["alisal"], today);
const svhInSeason = inSeason(byId["salinas-valley-health"], today);

const currentMonth = MONTHS.find((m) => m.iso === today.slice(0, 7));

const todayLine = openTodayLine(today, ordered, place);
const todayAnswer = sessionsOn(today, ordered).length ? `Yes. ${todayLine}` : `Not today. ${todayLine}`;

const faq = [
  {
    q: "Is there a farmers market in Monterey today?",
    a: `${todayAnswer} In the City of Monterey itself, the year-round markets are Tuesday afternoon on Alvarado Street and Friday morning at Del Monte Shopping Center.`,
  },
  {
    q: "What day is the Monterey farmers market?",
    a: `Monterey has two year-round markets: Tuesday, the Old Monterey Marketplace on Alvarado Street downtown (4–7pm October to April, 4–8pm May to September), and Friday, the Monterey Farmers Market at Del Monte Shopping Center (${hrs("monterey-friday")}). A third runs at Del Monte Shopping Center on Sundays from May through September only.`,
  },
  {
    q: "What day is the Salinas farmers market?",
    a: `Saturday in Oldtown, on the 300 block of Main Street (${hrs("oldtown-salinas")}), and Wednesday at Natividad Medical Center (${hrs("natividad")}), year round. ${
      svhInSeason ? `Salinas Valley Health's Friday market (${hrs("salinas-valley-health")}) runs until 6 November 2026. ` : ""
    }${
      alisalInSeason
        ? `The Alisal market on East Alisal Street runs Tuesdays ${hrs("alisal")} until 20 October 2026; its winter day and hours have not been published.`
        : `The Alisal market's winter day and hours have not been published.`
    }`,
  },
  {
    q: "What are the hours of the Monterey farmers markets?",
    a: `Old Monterey (Tuesday): 4–7pm October to April, 4–8pm May to September. Del Monte Center (Friday): ${hrs("monterey-friday")}. Pacific Grove (Monday): ${hrs("pacific-grove")}, closing at 6pm in winter. Seaside (Thursday): ${hrs("seaside")}. Carmel-by-the-Sea (Thursday): ${hrs("carmel-by-the-sea")}. Marina (Sunday): ${hrs("marina")}.`,
  },
  {
    q: "Are Monterey County farmers markets open year round?",
    a: `Five say so: Old Monterey (Tuesday), Del Monte Center (Friday), Pacific Grove (Monday), Marina (Sunday) and Natividad (Wednesday). Oldtown Salinas runs every Saturday, rain or shine. Seaside, Carmel-by-the-Sea and Castroville were running in October 2026, but their operators state no season. The Del Monte Sunday, Carmel Barnyard and Soledad markets are summer-only and have finished for 2026.`,
  },
  {
    q: "Can I use EBT, CalFresh or Market Match?",
    a: `At the Everyone's Harvest markets — Pacific Grove, Seaside, Marina, Alisal, Natividad and Salinas Valley Health — yes: EBT, WIC and senior benefits are accepted, with Market Match on EBT. Castroville takes EBT with a $15 match. At the Friday market at Del Monte Center, EBT stops at 11am; the operator gives the start as 9am on one page and 8am on another, so come between 9 and 11.`,
  },
  {
    q: "Can I bring my dog?",
    a: `Not to the Del Monte Center markets. Their operator states: "${PET_RULE.text}" The other operators publish no pet policy of their own.`,
  },
];
---

<FarmersMarketPage
  title="Monterey County Farmers Markets: Schedule by Day (2026)"
  h1Lead="Monterey Farmers Markets:"
  h1Accent="Days, Hours & Locations"
  description="Monterey County farmers markets by day: Old Monterey Tuesdays, Del Monte Center Fridays, plus Pacific Grove, Seaside, Marina, Carmel and Salinas."
  path="/monterey-farmers-market/"
  place={place}
  markets={ordered}
  areas={areas}
  intro="There is a farmers market somewhere in Monterey County every day of the week. In Monterey itself, the two year-round markets are Tuesday afternoon on Alvarado Street and Friday morning at Del Monte Shopping Center. Around the Peninsula, Pacific Grove has Mondays, Seaside and Carmel-by-the-Sea Thursdays, and Marina Sundays; Salinas has Wednesday and Saturday markets all year. Every day, time and address here comes from the market operators' own sites."
  faq={faq}
  skipped={montereySkipped}
  extraSources={[FALL_PRODUCE.source, PET_RULE.source]}
  sibling={{ href: "/santa-cruz-farmers-market/", label: "Santa Cruz County farmers markets" }}
  today={today}
>
  <link slot="head" rel="canonical" href="https://montereybayevents.com/monterey-farmers-market/" />

  <section slot="after-table" class="mt-14">
    <h2 class="border-b border-border/70 pb-2 text-3xl text-brass">Which market fits your visit</h2>
    <p class="mt-5 text-base leading-relaxed text-muted-foreground">
      Monterey's two year-round markets are different kinds of outing. Tuesday
      on Alvarado Street is an evening street market with crafts and food
      stalls as well as produce. Friday at Del Monte Center is a morning market
      for doing the week's food shopping. Some common situations:
    </p>
    <ul class="mt-5 space-y-4">
      <li class="flex gap-3 text-base leading-relaxed text-muted-foreground">
        <span class="text-brass">—</span>
        <span>
          <strong class="text-foreground">A weekend on the Peninsula between October and April.</strong>{" "}
          This is where plans most often go wrong. Monterey's Sunday market at
          Del Monte Center is summer-only and finished on 27 September. The
          Peninsula's Sunday option is Marina (10am–2pm, Reservation Road). On
          Saturday the nearest is Oldtown Salinas (9am–2pm), or the{" "}
          <a href={NEARBY_YEAR_ROUND.url} target="_blank" rel="noreferrer" class="text-brass hover:underline">
            {NEARBY_YEAR_ROUND.name}
          </a>{" "}
          in Santa Cruz County.
        </span>
      </li>
      <li class="flex gap-3 text-base leading-relaxed text-muted-foreground">
        <span class="text-brass">—</span>
        <span>
          <strong class="text-foreground">Paying with CalFresh on a Friday.</strong>{" "}
          EBT at Del Monte Center stops at 11am, an hour before the market
          closes. The operator gives the start as 9am on its homepage and 8am
          on its services page, so come between 9 and 11.
        </span>
      </li>
      <li class="flex gap-3 text-base leading-relaxed text-muted-foreground">
        <span class="text-brass">—</span>
        <span>
          <strong class="text-foreground">Only carrying a card on a Friday.</strong>{" "}
          Buy Farmers Market Big Bucks at the Information Booth with your card.
          Every vendor accepts them like cash.
        </span>
      </li>
      <li class="flex gap-3 text-base leading-relaxed text-muted-foreground">
        <span class="text-brass">—</span>
        <span>
          <strong class="text-foreground">After work on a Tuesday in winter.</strong>{" "}
          From October to April the Alvarado Street market closes at 7pm, an
          hour earlier than in summer. If you drive, have coins or the
          ParkMobile app ready: the City's meters have not taken cards since
          1 October 2026.
        </span>
      </li>
      <li class="flex gap-3 text-base leading-relaxed text-muted-foreground">
        <span class="text-brass">—</span>
        <span>
          <strong class="text-foreground">A Monday in Pacific Grove.</strong>{" "}
          The market at Central and Grand runs 3–7pm, but closes at 6pm in
          winter, and its operator does not say which months count as winter.
          Arrive before 6 from late autumn to spring.
        </span>
      </li>
    </ul>
  </section>

  <Fragment slot="after-markets">
    <section class="mt-14">
      <h2 class="border-b border-border/70 pb-2 text-3xl text-brass">What's in season</h2>
      <p class="mt-5 text-base leading-relaxed text-muted-foreground">
        In {FALL_PRODUCE.asOf} the Del Monte markets' operator said these were
        starting to fill the tables: {FALL_PRODUCE.items.join(", ")}. That was
        one reading at the turn of the season, not a weekly list. Year round,
        the Friday market at Del Monte Center has the widest published range on
        the Peninsula: {fridayVendorCount} vendors, {fridayOrganic} of them
        labelled organic and {fridayMakers} bakers, makers and prepared-food
        stalls.
      </p>
    </section>

    <section class="mt-14 border-l-2 border-brass bg-surface/60 px-6 py-8">
      <h2 class="text-3xl text-brass">What the operators do not publish</h2>
      <ul class="mt-5 space-y-4">
        <li class="text-base leading-relaxed text-muted-foreground">
          <strong class="text-foreground">Holiday closures in Monterey.</strong>{" "}
          Christmas Day and New Year's Day 2027 both fall on a Friday, and the
          Del Monte operator does not say whether the Friday market runs on
          them. The Everyone's Harvest markets do say: most close for about two
          weeks over the holidays.
        </li>
        <li class="text-base leading-relaxed text-muted-foreground">
          <strong class="text-foreground">A season for Seaside, Carmel-by-the-Sea and Castroville.</strong>{" "}
          All three were running in October 2026, but none of their operators
          says whether they continue through winter.
        </li>
        <li class="text-base leading-relaxed text-muted-foreground">
          <strong class="text-foreground">The Alisal market's winter schedule.</strong>{" "}
          Its winter season starts 28 October 2026 — a Wednesday, where the
          summer market is on Tuesdays — with no day or hours published yet.
        </li>
        <li class="text-base leading-relaxed text-muted-foreground">
          <strong class="text-foreground">Payment on Tuesdays in Monterey.</strong>{" "}
          The Old Monterey Business Association lists no EBT or card
          arrangement for the Alvarado Street market.
        </li>
        <li class="text-base leading-relaxed text-muted-foreground">
          <strong class="text-foreground">The Friday market's old location.</strong>{" "}
          Older listings still put it at Monterey Peninsula College. It moved
          to Del Monte Shopping Center in March 2020.
        </li>
      </ul>
    </section>
  </Fragment>

  <p slot="footer-links" class="mt-4 text-base leading-relaxed text-muted-foreground">
    {currentMonth && (
      <>
        Festivals, fairs and holiday markets:{" "}
        <a href={monthHref(currentMonth.key)} class="text-brass hover:underline">
          what's on in {currentMonth.label}
        </a>.
      </>
    )}
  </p>
</FarmersMarketPage>
