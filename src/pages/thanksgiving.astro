---
// /thanksgiving/ — Thanksgiving weekend 2026 (v2.S, 2026-11-24).
//
// Built from the regional rows: every dated listing that falls on Thursday 26
// to Sunday 29 November is grouped by day, so this page cannot disagree with
// the event pages it links to. The "things to do" copy is the only hand-written
// part, and every hour or price in it is from the operator's own page, fetched
// 2026-11-24 (notes: data/research/v2s-thanksgiving-sources-2026-11-24.md).
// Where an operator had not published Thanksgiving hours we could read, the
// page says so rather than guess.
import BaseLayout from "../layouts/BaseLayout.astro";
import { pacificToday } from "../lib/isPast";
import { eventHref, regionalEvents, type RegionalEvent } from "../data/events-2026";
import { buildItemListJsonLd } from "../lib/regionalEventSchema";
import { THANKSGIVING_2026 } from "../data/season";

const site = "https://montereybayevents.com";
const path = "/thanksgiving/";
const canonical = `${site}${path}`;
const today = pacificToday();
const isOver = today > THANKSGIVING_2026.to;

const DAYS = [
  { iso: "2026-11-26", label: "Thursday 26 November", short: "Thanksgiving Day" },
  { iso: "2026-11-27", label: "Friday 27 November", short: "Black Friday" },
  { iso: "2026-11-28", label: "Saturday 28 November", short: "Small Business Saturday" },
  { iso: "2026-11-29", label: "Sunday 29 November", short: "Holiday Parade of Lights" },
];

const on = (e: RegionalEvent, iso: string) => !!e.start && e.start <= iso && (e.end ?? e.start) >= iso;
const multiDay = (e: RegionalEvent) => !!e.end && e.end !== e.start;
const byName = (a: RegionalEvent, b: RegionalEvent) =>
  (a.startTime ?? "99").localeCompare(b.startTime ?? "99") || a.name.localeCompare(b.name);

// Day by day shows only that day's one-off events. Season-long and multi-day
// listings (rink, Boardwalk, Sparky's, Wonderfest, Makers Market) go in the
// "All weekend" block instead, with their weekend days and hours spelled out.
const weekend = regionalEvents.filter((e) => DAYS.some((d) => on(e, d.iso)));
const byDay = DAYS.map((d) => ({ ...d, events: weekend.filter((e) => !multiDay(e) && on(e, d.iso)).sort(byName) }));

const bySlug = (slug: string) => {
  const e = regionalEvents.find((x) => x.slug === slug);
  if (!e) throw new Error(`/thanksgiving/: row "${slug}" missing from events-2026.ts`);
  return e;
};
const trots = regionalEvents.filter((e) => e.category.startsWith("Running") && e.start === "2026-11-26");
const lightings = regionalEvents
  .filter((e) => e.category === "Holiday / Tree Lighting" && e.start && e.start >= "2026-11-26")
  .sort((a, b) => a.start!.localeCompare(b.start!));
const carmel = bySlug("carmel-holidays-in-the-park-tree-menorah-lighting");
const runForPie = bySlug("run-for-pie-2026");
const rink = bySlug("ice-skating-by-the-bay");
const boardwalk = bySlug("santa-cruz-beach-boardwalk-winter-wonderland");
const sparkys = bySlug("sparkys-holiday-lights");
const wonderfest = bySlug("winter-wonderfest-monterey");
const makers = bySlug("downtown-santa-cruz-makers-market-holiday-pop-up");

// One wording for the Boardwalk's dates, from its own announcement
// (news.beachboardwalk.com, 2026): "on select days from Thursday, November 26
// through Sunday, January 3, 2027". Used in every mention on this page.
const BOARDWALK_DAYS = "on select days from Thursday 26 November to Sunday 3 January";

// Weekend days and hours per row, each from the row's own times[] (organiser-published).
const allWeekend: { e: RegionalEvent; when: string }[] = [
  { e: rink, when: "Opens for the season on Thanksgiving Day, 12pm–8pm (holiday hours). Friday and Saturday 11am–10pm, Sunday 12pm–8pm (the rink notes exceptions on some dates). $20 adults, $18 for 12 and under, plus $5 skate rental." },
  { e: boardwalk, when: `Opens on Thanksgiving Day. Free entry (rides extra: $2 each after 5pm), ${BOARDWALK_DAYS}; the Boardwalk publishes each day's hours, including Thanksgiving's, on its Winter Wonderland page. Holiday drone show and tree lighting on Saturday 28 November.` },
  { e: sparkys, when: "Drive-through Friday to Sunday, 27–29 November, 5:30pm–9pm. $20 a car online, $25 at the gate." },
  { e: wonderfest, when: "Walk-through Friday to Sunday, 27–29 November, 5pm–9pm. Not open on Thanksgiving Day." },
  { e: makers, when: "Friday and Saturday 11am–7pm, Sunday 11am–5pm, at 1407 Pacific Ave." },
];

const listed = [...new Map(weekend.map((e) => [e.slug, e])).values()].sort(
  (a, b) => a.start!.localeCompare(b.start!) || a.name.localeCompare(b.name),
);
const allListed = [...new Map([...listed, ...lightings].map((e) => [e.slug, e])).values()];

const price = (e: RegionalEvent) =>
  e.admission === "free" ? "Free" : typeof e.admission === "object" ? `From $${e.admission.from}` : undefined;
const hoursOn = (e: RegionalEvent) => (e.times && e.times.length === 1 ? e.times[0]!.hours : undefined);

// ── FAQ — rendered visibly and emitted as FAQPage from the same array ───────
const faq: { q: string; a: string; sources?: { href: string; label: string }[] }[] = [
  {
    q: "What's open on Thanksgiving in Monterey?",
    a: `Ice Skating by the Bay in Custom House Plaza opens its season on Thanksgiving Day, 12pm to 8pm. Monterey-Salinas Transit runs free rides systemwide on Thanksgiving, on a limited holiday schedule (JAZZ A and B, and lines 1, 5, 20, 23, 41 and 49). The Monterey Bay Aquarium says it is open daily except Christmas Day, and lists its hours on its own schedule page; we could not read Thanksgiving hours there, so check before you go.`,
  },
  {
    q: "When is the Cannery Row tree lighting?",
    a: `Friday 27 November 2026, the day after Thanksgiving. The tree in Steinbeck Plaza is lit between 5:45pm and 6:00pm; the free event runs from 2:00pm to 9:00pm, with Santa's Toy Factory open from 6:00pm.`,
  },
  {
    q: "Are there turkey trots near Santa Cruz?",
    a: `Yes: Run For Pie in Soquel on Thanksgiving morning — a kids' half mile at 8:35am, a 5K at 9:05am and the Pie Mile at 10:15am, run by Fleet Feet Aptos for Second Harvest Food Bank. The Santa Cruz Track Club's Turkey Trot at Natural Bridges was on Saturday 21 November this year, before the holiday. On the Monterey side, the Carmel Valley Athletic Club's Turkey Trot is a 5K at 9:00am on Thanksgiving.`,
  },
  {
    q: "When is the Carmel tree lighting?",
    a: `Friday 4 December 2026, in Devendorf Park — the week after Thanksgiving. Visit Carmel's listing has Santa arriving by fire truck at 3:30pm, a menorah lighting at 4:00pm and the tree lit at about 5:30pm, followed by Carmel Plaza's holiday open house from 5:00pm to 7:00pm.`,
    sources: [
      { href: "https://carmelcalifornia.com/event/holiday-tree-and-menorah-lighting-ceremony/", label: "Visit Carmel: Holiday Tree and Menorah Lighting" },
      { href: "https://ci.carmel.ca.us/events", label: "City of Carmel-by-the-Sea events (date)" },
      { href: "https://carmelplaza.com/happening/annual-holiday-open-house/", label: "Carmel Plaza: Annual Holiday Open House" },
    ],
  },
];

// ── Metadata + structured data ────────────────────────────────────────────
const title = "Thanksgiving Weekend 2026 in Monterey & Santa Cruz (Nov 26–29)";
const description =
  "Turkey trots, the Cannery Row tree lighting, Black Friday and Small Business Saturday events, and what's open on Thanksgiving Day around Monterey Bay.";
const image = `${site}/og/thanksgiving.png`;

const itemList = buildItemListJsonLd(allListed, site, eventHref, "Thanksgiving weekend 2026 around Monterey Bay");
const jsonLd = [
  { ...itemList, url: canonical },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${site}/` },
      { "@type": "ListItem", position: 2, name: "Events", item: `${site}/events/` },
      { "@type": "ListItem", position: 3, name: "Thanksgiving weekend", item: canonical },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];

const card = "border-l-2 border-border/80 bg-surface/60 px-5 py-4 transition-colors hover:border-brass";
const meta =
  "mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.65rem] uppercase tracking-[0.14em] text-muted-foreground";
const h2 = "border-b border-border/70 pb-2 text-3xl text-brass";
const p = "mt-4 max-w-3xl text-base leading-relaxed text-muted-foreground";
const link = "text-brass hover:underline";
---

<BaseLayout>
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Monterey Bay Events" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Thanksgiving weekend 2026 around Monterey Bay" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    {jsonLd.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
  </Fragment>

  <main class="mx-auto max-w-4xl px-5 py-14">
    <nav aria-label="Breadcrumb" class="text-[0.65rem] font-bold uppercase tracking-[0.2em] text-muted-foreground">
      <a href="/" class="hover:text-brass">Home</a>
      <span aria-hidden="true"> / </span>
      <a href="/events/" class="hover:text-brass">Events</a>
      <span aria-hidden="true"> / </span>
      <span class="text-foreground">Thanksgiving weekend</span>
    </nav>

    <p class="eyebrow mt-6">Thursday 26 – Sunday 29 November 2026</p>
    <h1 class="mt-2 text-5xl leading-[0.88] sm:text-7xl">
      Thanksgiving weekend on <span class="text-brass">Monterey Bay</span>
    </h1>
    {isOver && (
      <p class="mt-6 max-w-3xl border-l-2 border-brass pl-4 text-base text-muted-foreground">
        Thanksgiving weekend 2026 is over. This page stays up as the record; for
        what's on now, see <a href="/events/december/" class={link}>December's events</a>.
      </p>
    )}
    <p class="mt-6 max-w-3xl text-lg leading-relaxed text-muted-foreground">
      Thanksgiving morning has two turkey trots — the CVAC Turkey Trot in Carmel
      Valley and Run For Pie in Soquel. On Friday, Cannery Row lights its tree in
      Steinbeck Plaza at about 6pm, free. Saturday brings Santa by kayak to Capitola
      Beach and the Tree For Peace lighting in Salinas, and Sunday the Salinas
      Holiday Parade of Lights. The Monterey ice rink opens on Thanksgiving Day itself.
      For every tree lighting, boat parade and light display of the season, see
      our <a href="/holiday-lights/" class={link}>holiday lights map</a>.
    </p>
    <p class={p}>
      Every listing below links to its own page with the organiser's times, prices
      and source. We list an event only when its organiser or city has published
      the 2026 date; where they have not published a time or a price, we say so
      rather than guess.
    </p>

    <!-- All weekend: season-long and multi-day listings -->
    <section class="mt-14" id="all-weekend">
      <h2 class={h2}>All weekend</h2>
      <p class={p}>
        These run across the weekend and beyond, so they are listed once here
        rather than under each day.
      </p>
      <div class="mt-6 grid gap-3">
        {allWeekend.map(({ e, when }) => (
          <article class={card}>
            <h3 class="text-xl leading-tight">
              <a href={eventHref(e)} class="text-foreground transition-colors hover:text-brass">{e.name}</a>
            </h3>
            <div class={meta}>
              <span>{e.city ?? e.cityText}</span>
              {e.venue && <span aria-hidden="true">·</span>}
              {e.venue && <span>{e.venue}</span>}
              {price(e) && <span aria-hidden="true">·</span>}
              {price(e) && <span class="text-brass">{price(e)}</span>}
            </div>
            <p class="mt-2 max-w-3xl text-sm leading-relaxed text-muted-foreground">{when}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- Day by day: one-off events only -->
    {byDay.map((d) => (
      <section class="mt-14" id={d.iso}>
        <h2 class={h2}>
          {d.label}{d.short && <span class="text-lg text-muted-foreground"> · {d.short}</span>}
        </h2>
        <div class="mt-6 grid gap-3">
          {d.events.map((e) => (
            <article class={card}>
              <h3 class="text-xl leading-tight">
                <a href={eventHref(e)} class="text-foreground transition-colors hover:text-brass">{e.name}</a>
              </h3>
              <div class={meta}>
                <span>{e.city ?? e.cityText}</span>
                {e.venue && <span aria-hidden="true">·</span>}
                {e.venue && <span>{e.venue}</span>}
                {hoursOn(e) && <span aria-hidden="true">·</span>}
                {hoursOn(e) && <span>{hoursOn(e)}</span>}
                {e.end && <span aria-hidden="true">·</span>}
                {e.end && <span>Runs {e.dateText}</span>}
                {price(e) && <span aria-hidden="true">·</span>}
                {price(e) && <span class="text-brass">{price(e)}</span>}
              </div>
              {e.description && (
                <p class="mt-2 max-w-3xl text-sm leading-relaxed text-muted-foreground">{e.description}</p>
              )}
            </article>
          ))}
        </div>
      </section>
    ))}

    <section class="mt-16">
      <h2 class={h2}>Turkey trots</h2>
      <p class={p}>
        {trots.length} races on Thanksgiving morning, one in each county. Both take
        same-week registration online; check the race page for what is still open.
      </p>
      <ul class="mt-4 space-y-3">
        {trots.map((e) => (
          <li class="text-base">
            <a href={eventHref(e)} class={link}>{e.name}</a>
            <span class="text-muted-foreground"> — {e.city}. {e.times?.[0]?.hours}.</span>
          </li>
        ))}
      </ul>
      <p class={p}>
        No 2026 turkey trot in Monterey, Pacific Grove, Salinas or Capitola had a
        published date when we checked on 24 November. The Santa Cruz Track Club's
        Turkey Trot at Natural Bridges ran on Saturday 21 November, the weekend
        before. Run For Pie's Pie Mile is the odd one: four laps of the track, a
        piece of pie per lap.
      </p>
    </section>

    <section class="mt-14">
      <h2 class={h2}>Tree lightings</h2>
      <p class={p}>
        The lightings start the day after Thanksgiving and run into the next week.
        In date order (the rest of the season's lightings are on the{" "}
        <a href="/holiday-lights/" class={link}>holiday lights map</a>):
      </p>
      <ul class="mt-4 space-y-3">
        {lightings.map((e) => (
          <li class="text-base">
            <a href={eventHref(e)} class={link}>{e.name}</a>
            <span class="text-muted-foreground"> — {e.dateText}, {e.venue}. {e.times?.[0]?.hours}.</span>
          </li>
        ))}
      </ul>
      <p class={p}>
        Cannery Row's is the biggest of the weekend: carolers from I Cantori di
        Carmel from 3:30pm, Santa on the balcony over the plaza, and his toy factory
        open from 6pm on the second floor of 685 Cannery Row. Carmel's comes a week
        later, on {carmel.dateText}, and includes a menorah lighting.
      </p>
    </section>

    <section class="mt-14">
      <h2 class={h2}>Shopping: Black Friday and Small Business Saturday</h2>
      <h3 class="mt-6 text-xl text-foreground">Monterey County</h3>
      <p class={p}>
        Carmel Plaza has Santa and live music in its courtyard from noon to 2pm on
        Black Friday, with KMBY broadcasting live, and shops running offers all
        weekend. In Salinas, the City pairs Saturday's Tree For Peace lighting with
        free all-day parking in the Monterey Street garage.
      </p>
      <h3 class="mt-6 text-xl text-foreground">Santa Cruz County</h3>
      <p class={p}>
        In downtown Santa Cruz, the Makers Market holiday pop-up opens at
        1407 Pacific Ave on Friday with 25 or more local makers, 11am to 7pm Friday
        and Saturday and 11am to 5pm Sunday. The Downtown Association's Reindeer
        Round-Up also starts on Friday: pick up a map at the information kiosk or
        Pacific Cookie Company and find the reindeer hidden in shops (10am–6pm, to
        23 December), and the North Pole mailbox for letters to Santa goes up outside
        Super Silver at 1301 Pacific Ave.
      </p>
      <p class={p}>
        On Small Business Saturday, Santa arrives by kayak at Capitola Beach at noon.
        Capitola Village has free three-hour parking from Thanksgiving through
        Christmas Day. Capitola Mall is closed on Thanksgiving and opens 8am–8pm on
        Friday, 10am–7pm on Saturday and 11am–6pm on Sunday.
      </p>
      <p class="mt-3 text-sm text-muted-foreground">
        We found no Black Friday or Small Business Saturday event published by
        Pacific Grove's chamber or downtown association for 2026.
      </p>
    </section>

    <section class="mt-14">
      <h2 class={h2}>Things to do on Thanksgiving Day</h2>
      <p class={p}>
        Ice Skating by the Bay and the Boardwalk's Winter Wonderland both open on
        Thanksgiving Day; their Thanksgiving hours are in <a href="#all-weekend" class={link}>All weekend</a> above.
      </p>
      <h3 class="mt-6 text-xl text-foreground">Monterey Bay Aquarium</h3>
      <p class={p}>
        The aquarium describes itself as open daily except Christmas Day, and its
        schedule page lists programmes for Thanksgiving Day, including the 10:30am
        sea otter feeding. It publishes daily opening hours on that page, which we
        could not read for 26 November — confirm on{" "}
        <a href="https://www.montereybayaquarium.org/visit/schedule?date=2026-11-26" class={link} rel="noopener">the aquarium's schedule</a>.
        It says to buy tickets in advance.
      </p>
      <h3 class="mt-6 text-xl text-foreground">Beaches and walks</h3>
      <p class={p}>
        Point Lobos State Natural Reserve is open 8am to 5pm, with last entry at
        4:30pm and a $10 vehicle day-use fee; State Parks warns that special rates
        can apply on holidays. Natural Bridges State Beach in Santa Cruz is open 8am
        to sunset, $10 a vehicle. Neither page says anything specific about
        Thanksgiving. At Garrapata, State Parks is asking visitors to stay off the
        sandy beaches and away from rocks and tidal zones, and the Rocky Ridge Trail
        is closed.
      </p>
      <h3 class="mt-6 text-xl text-foreground">Getting around</h3>
      <p class={p}>
        Monterey-Salinas Transit runs free systemwide on Thanksgiving Day, on a
        limited holiday schedule: JAZZ A and JAZZ B between the aquarium and Sand
        City, and lines 1, 5, 20, 23, 41 and 49. On Friday it runs a Saturday
        schedule, with lines 25, 40 and 47 not running; regular service resumes on
        Saturday.
      </p>
    </section>

    <section class="mt-14 max-w-3xl">
      <h2 class={h2}>Common questions</h2>
      <dl class="mt-6 space-y-6">
        {faq.map((f) => (
          <div>
            <dt class="text-lg font-semibold text-foreground">{f.q}</dt>
            <dd class="mt-2 text-base leading-relaxed text-muted-foreground">
              {f.a}
              {f.sources && (
                <span class="mt-2 block text-sm">
                  Sources:{" "}
                  {f.sources.map((s, i) => (
                    <Fragment>{i > 0 && " · "}<a href={s.href} class={link} rel="noopener">{s.label}</a></Fragment>
                  ))}
                </span>
              )}
            </dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="mt-16 border-t border-border/70 pt-8">
      <h2 class="text-2xl text-brass">More around the holidays</h2>
      <div class="mt-4 grid gap-2 sm:grid-cols-2">
        <a href="/holiday-lights/" class="border-l-2 border-border/80 bg-surface/60 px-4 py-3 text-sm text-foreground transition-colors hover:border-brass hover:text-brass">
          Holiday lights map: every display and tree lighting
        </a>
        <a href="/new-years-eve/" class="border-l-2 border-border/80 bg-surface/60 px-4 py-3 text-sm text-foreground transition-colors hover:border-brass hover:text-brass">
          New Year's Eve 2026: First Night, parties and dinners
        </a>
        <a href="/events/november/" class="border-l-2 border-border/80 bg-surface/60 px-4 py-3 text-sm text-foreground transition-colors hover:border-brass hover:text-brass">
          Everything on the Central Coast in November
        </a>
        <a href="/events/december/" class="border-l-2 border-border/80 bg-surface/60 px-4 py-3 text-sm text-foreground transition-colors hover:border-brass hover:text-brass">
          December: parades, markets and First Night
        </a>
        <a href="/events/pacific-grove/" class="border-l-2 border-border/80 bg-surface/60 px-4 py-3 text-sm text-foreground transition-colors hover:border-brass hover:text-brass">
          Events in Pacific Grove, including its tree lighting
        </a>
        <a href={`${eventHref(runForPie)}`} class="border-l-2 border-border/80 bg-surface/60 px-4 py-3 text-sm text-foreground transition-colors hover:border-brass hover:text-brass">
          Run For Pie: the Thanksgiving race with pie in it
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
