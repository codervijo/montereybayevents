---
// /things-to-do/ — index of the town hubs (v7.B). One card per built hub;
// towns without a hub are not listed until theirs exists.
import BaseLayout from "../../layouts/BaseLayout.astro";
import { HUBS, hubHref, SECTIONS, bySection } from "../../data/thingsToDo";

const site = "https://montereybayevents.com";
const canonical = `${site}/things-to-do/`;
const hubs = Object.values(HUBS);
const title = "Things to Do Around Monterey Bay, Town by Town";
const description =
  "Town guides for the Monterey Bay area: sights, beaches, hikes, free things, rainy-day ideas and what's on this week, each place checked with its official site.";
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: title,
    url: canonical,
    numberOfItems: hubs.length,
    itemListElement: hubs.map((h, i) => ({ "@type": "ListItem", position: i + 1, name: `Things to do in ${h.town}`, url: `${site}${hubHref(h.slug)}` })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${site}/` },
      { "@type": "ListItem", position: 2, name: "Things to do", item: canonical },
    ],
  },
];
---

<BaseLayout>
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Monterey Bay Events" />
    <meta property="og:image" content={`${site}/og/ttd.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
  </Fragment>

  <main class="mx-auto max-w-4xl px-5 py-14">
    <nav aria-label="Breadcrumb" class="text-[0.65rem] font-bold uppercase tracking-[0.2em] text-muted-foreground">
      <a href="/" class="hover:text-brass">Home</a>
      <span aria-hidden="true"> / </span>
      <span class="text-foreground">Things to do</span>
    </nav>
    <h1 class="mt-6 text-5xl leading-[0.88] sm:text-7xl">Things to do, <span class="text-brass">town by town</span></h1>
    <p class="mt-6 max-w-3xl text-lg leading-relaxed text-muted-foreground">
      One guide per town: what to see, where the beaches and trails are, what's
      free, what to do when it rains, and what's on this week from our events
      calendar. Every place is checked against its own official site.
    </p>
    <div class="mt-10 grid gap-4 sm:grid-cols-2">
      {hubs.map((h) => (
        <a href={hubHref(h.slug)} class="block border-l-2 border-brass bg-surface/60 px-6 py-6 transition-colors hover:bg-surface">
          <p class="text-[0.6rem] font-bold uppercase tracking-[0.2em] text-muted-foreground">{h.items.length} places</p>
          <p class="mt-2 text-3xl leading-tight text-brass">Things to do in {h.town} →</p>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{bySection(h.items).map((s) => SECTIONS[s.key].label).join(" · ")}</p>
        </a>
      ))}
    </div>
    <p class="mt-10 max-w-3xl text-sm text-muted-foreground">
      More towns are on the way. For dated events across the whole bay, see the <a href="/events/" class="text-brass hover:underline">events calendar</a>.
    </p>
  </main>
</BaseLayout>
