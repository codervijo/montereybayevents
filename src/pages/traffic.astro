---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ROAD_CLOSURES_URL } from "../data/events";
import {
  SOURCES,
  arrivalTips,
  closures,
  derivedCount,
  highways,
  officialCount,
  parking,
  transit,
  unpublishedCount,
  type Confidence,
} from "../data/traffic";

const site = "https://montereybayevents.com";
const title =
  "Monterey Car Week 2026 Traffic, Road Closures & Parking — August 7–16";
const description =
  "Road closures by day, Highway 1 and Highway 68 conditions, parking at Pebble Beach, Laguna Seca, Ocean Avenue, Lighthouse Avenue and Asilomar, shuttles and best arrival times for Monterey Car Week 2026.";
const canonical = `${site}/traffic/`;

// Live official feeds — these belong at the top because they are the only
// things on the page that update faster than the page does.
const liveSources = [
  {
    title: "County closure map",
    body: "The County of Monterey publishes daily closure and detour information for Highway One, Ocean Avenue, Pacific Grove and the routes into Pebble Beach.",
    cta: { label: "Open county closure list", href: ROAD_CLOSURES_URL },
  },
  {
    title: "Caltrans live cameras",
    body: "Caltrans operates live cameras and an incident feed along Highway 1 and Highway 68. This is the check to run immediately before leaving, not the night before.",
    cta: { label: "Caltrans QuickMap", href: SOURCES.quickmap.url },
  },
  {
    title: "Public safety text alerts",
    body: "Text CARWEEK to 65513 to receive public safety messages throughout the week — incidents, closures and emergency notices.",
  },
  {
    title: "County permits",
    body: "For county permit questions, call the County of Monterey Permit Center at 831-755-5025, or contact the city where the event takes place.",
    cta: { label: "Call 831-755-5025", href: "tel:8317555025" },
  },
];

// Each status is a positive statement about the public record — never a
// "we haven't checked" marker. `official` needs no badge; its source link
// already says who published it.
const BADGE: Partial<Record<Confidence, string>> = {
  unpublished: "Nobody publishes this",
  derived: "Inferred from event times",
};
const badge = (c?: Confidence) => (c ? BADGE[c] : undefined);
const leadIn = (c?: Confidence) =>
  c === "derived" ? "What is actually sourced:" : "Why there is nothing to cite:";

// A page that mixes confirmed and unconfirmed facts has to say so in its own
// schema description too, not only in the visible markup.
const webPage = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title,
  description,
  url: canonical,
  isPartOf: { "@type": "WebSite", name: "Monterey Bay Events", url: `${site}/` },
  about: {
    "@type": "Event",
    name: "Monterey Car Week 2026",
    startDate: "2026-08-07",
    endDate: "2026-08-16",
    eventStatus: "https://schema.org/EventScheduled",
    eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
    location: {
      "@type": "Place",
      name: "Monterey Peninsula",
      address: {
        "@type": "PostalAddress",
        addressLocality: "Monterey",
        addressRegion: "CA",
        addressCountry: "US",
      },
    },
  },
};
---

<BaseLayout>
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="description" content={description.slice(0, 155)} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description.slice(0, 200)} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Monterey Bay Events" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={`${site}/og-carweek.jpg`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description.slice(0, 200)} />
    <meta name="twitter:image" content={`${site}/og-carweek.jpg`} />

    <script type="application/ld+json" set:html={JSON.stringify(webPage)}></script>
  </Fragment>

  <main class="mx-auto max-w-4xl px-5 py-14">
    <p class="eyebrow">August 7 – 16, 2026 · Plan your movement</p>
    <h1 class="mt-2 text-5xl leading-[0.88] sm:text-7xl">
      Car Week <span class="text-brass">traffic</span>, closures &amp; parking
    </h1>
    <p class="mt-6 max-w-2xl text-base leading-relaxed text-muted-foreground">
      Car Week puts hundreds of thousands of extra vehicles onto peninsula roads
      that were not built for them. This page collects what the cities, the county,
      Caltrans and the event operators have actually published — closures by day,
      how Highway 1 and Highway 68 behave, where you can park at each venue, which
      shuttles run, and when to arrive.
    </p>

    <div
      class="mt-8 max-w-2xl border-l-2 border-brass/60 bg-surface/60 px-5 py-4 text-sm leading-relaxed text-muted-foreground"
    >
      <p>
        <span class="font-semibold text-brass">How to read this page.</span>{" "}
        {officialCount} of the facts below are the agency's or the operator's own
        words, and each links to the page they are on. {derivedCount} are marked{" "}
        <span class="whitespace-nowrap font-semibold text-brass"
          >Inferred from event times</span
        > — we know when and where an event runs because its organizer published that,
        and the closure is our reading on top of it, not a notice anyone issued.{" "}
        {unpublishedCount} are marked{" "}
        <span class="whitespace-nowrap font-semibold text-brass"
          >Nobody publishes this</span
        >, which is a finding rather than a gap: there is no Pacific Grove parking plan
        to look up, and Laguna Seca will tell you where General Parking is but not what
        it costs.
      </p>
      <p class="mt-3">
        Nothing here is flagged as unchecked. Where we could not stand a claim up, we
        did not make it — a price we cannot source is simply absent, with a link to
        whoever sets it, because a stale number read as current is worse than no number
        at all.
      </p>
      <p class="mt-3">
        Widely-circulated Car Week closure tables are frequently
        <strong class="text-foreground">prior-year data</strong> — the most-syndicated
        one dates from 2023. None of its dates are reproduced here.
      </p>
    </div>

    <!-- Live feeds ------------------------------------------------------- -->
    <section class="mt-14">
      <p class="eyebrow">Check these first</p>
      <h2 class="mt-2 text-4xl leading-none sm:text-5xl">Live official sources</h2>
      <div class="mt-6 grid gap-3 md:grid-cols-2">
        {
          liveSources.map((c) => (
            <div class="flex flex-col border-l-2 border-border/80 bg-surface/60 px-6 py-6 transition-colors hover:border-brass">
              <h3 class="text-2xl leading-tight">{c.title}</h3>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-muted-foreground">
                {c.body}
              </p>
              {c.cta && (
                <a
                  href={c.cta.href}
                  target={c.cta.href.startsWith("tel:") ? undefined : "_blank"}
                  rel="noreferrer"
                  class="mt-5 w-fit border border-brass/60 px-4 py-2 text-[0.65rem] font-bold uppercase tracking-[0.16em] text-brass transition-colors hover:bg-brass hover:text-primary-foreground"
                >
                  {c.cta.label}
                </a>
              )}
            </div>
          ))
        }
      </div>
    </section>

    <!-- Closures --------------------------------------------------------- -->
    <section class="mt-16">
      <p class="eyebrow">Where the roads shut</p>
      <h2 class="mt-2 text-4xl leading-none sm:text-5xl">Closures by day</h2>
      <p class="mt-4 max-w-2xl text-sm leading-relaxed text-muted-foreground">
        One confirmed multi-day closure dominates the week — 17-Mile Drive. The rest
        are street-level and event-driven, and the host cities publish event times far
        more reliably than they publish closure notices.
      </p>

      <div class="mt-8 space-y-3">
        {
          closures.map((c) => (
            <article class="border-l-2 border-border/80 bg-surface/60 px-6 py-5">
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <h3 class="text-2xl leading-tight text-foreground">{c.road}</h3>
                {c.segment && (
                  <span class="text-sm text-muted-foreground">{c.segment}</span>
                )}
                {badge(c.confidence) && (
                  <span class="border border-brass/50 px-2 py-0.5 text-[0.6rem] font-bold uppercase tracking-[0.16em] text-brass">
                    {badge(c.confidence)}
                  </span>
                )}
              </div>
              <p class="mt-2 text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-brass">
                {c.city} · {c.when}
                {c.hours ? ` · ${c.hours}` : ""}
              </p>
              <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
                {c.reason}
              </p>
              {c.basis && (
                <p class="mt-3 border-l border-brass/40 pl-3 text-xs leading-relaxed text-muted-foreground/90">
                  <span class="font-semibold text-brass">{leadIn(c.confidence)}</span>{" "}
                  {c.basis}
                </p>
              )}
              {c.source && (
                <a
                  href={c.source.url}
                  target="_blank"
                  rel="noreferrer"
                  class="mt-3 inline-block text-xs text-brass hover:underline"
                >
                  {c.source.label} ↗
                </a>
              )}
            </article>
          ))
        }
      </div>

      <p class="mt-6 max-w-2xl text-sm leading-relaxed text-muted-foreground">
        Closures move. Before you drive into any of these, check the{" "}
        <a
          href={ROAD_CLOSURES_URL}
          target="_blank"
          rel="noreferrer"
          class="text-brass hover:underline">county closure list</a
        >{" "}
        and{" "}
        <a
          href={SOURCES.quickmap.url}
          target="_blank"
          rel="noreferrer"
          class="text-brass hover:underline">Caltrans QuickMap</a
        >.
      </p>
    </section>

    <!-- Highways --------------------------------------------------------- -->
    <section class="mt-16">
      <p class="eyebrow">The two roads that matter</p>
      <h2 class="mt-2 text-4xl leading-none sm:text-5xl">Highway 1 and Highway 68</h2>
      <div class="mt-8 space-y-3">
        {
          highways.map((h) => (
            <article class="border-l-2 border-border/80 bg-surface/60 px-6 py-5">
              <div class="flex flex-wrap items-baseline gap-x-3">
                <h3 class="text-2xl leading-tight text-foreground">{h.name}</h3>
                {badge(h.confidence) && (
                  <span class="border border-brass/50 px-2 py-0.5 text-[0.6rem] font-bold uppercase tracking-[0.16em] text-brass">
                    {badge(h.confidence)}
                  </span>
                )}
              </div>
              <p class="mt-2 text-sm italic leading-relaxed text-muted-foreground">
                {h.role}
              </p>
              <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
                {h.guidance}
              </p>
              {h.source && (
                <a
                  href={h.source.url}
                  target="_blank"
                  rel="noreferrer"
                  class="mt-3 inline-block text-xs text-brass hover:underline"
                >
                  {h.source.label} ↗
                </a>
              )}
            </article>
          ))
        }
      </div>
    </section>

    <!-- Parking ---------------------------------------------------------- -->
    <section class="mt-16">
      <p class="eyebrow">Where to leave the car</p>
      <h2 class="mt-2 text-4xl leading-none sm:text-5xl">Parking by venue</h2>
      <div class="mt-8 space-y-8">
        {
          parking.map((v) => (
            <article id={v.id} class="scroll-mt-32 border-t border-border/70 pt-6">
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <h3 class="text-3xl leading-none text-brass">{v.venue}</h3>
                <span class="text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-muted-foreground">
                  {v.city}
                </span>
              </div>

              {v.approach && (
                <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted-foreground">
                  {badge(v.approachConfidence) && (
                    <span class="mr-2 border border-brass/50 px-2 py-0.5 text-[0.6rem] font-bold uppercase tracking-[0.16em] text-brass">
                      {badge(v.approachConfidence)}
                    </span>
                  )}
                  {v.approach}
                </p>
              )}

              <ul class="mt-5 divide-y divide-border/70 border-y border-border/70">
                {v.lots.map((l) => (
                  <li class="py-4">
                    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                      <span class="text-base text-foreground">{l.name}</span>
                      {l.cost && (
                        <span class="border border-brass/50 px-2 py-0.5 text-[0.6rem] font-semibold uppercase tracking-[0.16em] text-brass">
                          {l.cost}
                        </span>
                      )}
                      {badge(l.confidence) && (
                        <span class="border border-brass/50 px-2 py-0.5 text-[0.6rem] font-bold uppercase tracking-[0.16em] text-brass">
                          {badge(l.confidence)}
                        </span>
                      )}
                    </div>
                    {l.note && (
                      <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                        {l.note}
                      </p>
                    )}
                    {l.basis && (
                      <p class="mt-2 border-l border-brass/40 pl-3 text-xs leading-relaxed text-muted-foreground/90">
                        <span class="font-semibold text-brass">{leadIn(l.confidence)}</span>{" "}
                        {l.basis}
                      </p>
                    )}
                  </li>
                ))}
              </ul>

              {v.shuttle && (
                <p class="mt-4 max-w-2xl text-sm leading-relaxed text-muted-foreground">
                  <span class="font-semibold text-brass">Shuttle.</span> {v.shuttle}
                </p>
              )}

              <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-xs">
                {v.href && (
                  <a href={v.href} class="text-brass hover:underline">
                    Event details and map →
                  </a>
                )}
                {v.lots.find((l) => l.source) && (
                  <a
                    href={v.lots.find((l) => l.source)!.source!.url}
                    target="_blank"
                    rel="noreferrer"
                    class="text-brass hover:underline"
                  >
                    {v.lots.find((l) => l.source)!.source!.label} ↗
                  </a>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Transit ---------------------------------------------------------- -->
    <section class="mt-16">
      <p class="eyebrow">Leave it parked</p>
      <h2 class="mt-2 text-4xl leading-none sm:text-5xl">Shuttles &amp; transit</h2>
      <div class="mt-8 space-y-3">
        {
          transit.map((t) => (
            <article class="border-l-2 border-border/80 bg-surface/60 px-6 py-5">
              <div class="flex flex-wrap items-baseline gap-x-3">
                <h3 class="text-xl leading-tight text-foreground">{t.name}</h3>
                {badge(t.confidence) && (
                  <span class="border border-brass/50 px-2 py-0.5 text-[0.6rem] font-bold uppercase tracking-[0.16em] text-brass">
                    {badge(t.confidence)}
                  </span>
                )}
              </div>
              <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
                {t.detail}
              </p>
              {t.basis && (
                <p class="mt-3 border-l border-brass/40 pl-3 text-xs leading-relaxed text-muted-foreground/90">
                  <span class="font-semibold text-brass">{leadIn(t.confidence)}</span>{" "}
                  {t.basis}
                </p>
              )}
              {t.cta && (
                <a
                  href={t.cta.href}
                  target="_blank"
                  rel="noreferrer"
                  class="mt-3 inline-block text-xs text-brass hover:underline"
                >
                  {t.cta.label} ↗
                </a>
              )}
            </article>
          ))
        }
      </div>
    </section>

    <!-- Arrival ---------------------------------------------------------- -->
    <section class="mt-16">
      <p class="eyebrow">When to go</p>
      <h2 class="mt-2 text-4xl leading-none sm:text-5xl">Best arrival times</h2>
      <p class="mt-4 max-w-2xl text-sm leading-relaxed text-muted-foreground">
        Each of these is anchored to a published gate or start time. Where the advice
        goes beyond what is published — how early the queue forms, how far the walk
        gets — the note says so, because nobody publishes that number.
      </p>
      <ul class="mt-6 divide-y divide-border/70 border-y border-border/70">
        {
          arrivalTips.map((t) => (
            <li class="py-5">
              <div class="flex flex-wrap items-baseline gap-x-3">
                <h3 class="text-lg text-brass">{t.where}</h3>
                {badge(t.confidence) && (
                  <span class="border border-brass/50 px-2 py-0.5 text-[0.6rem] font-bold uppercase tracking-[0.16em] text-brass">
                    {badge(t.confidence)}
                  </span>
                )}
              </div>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                {t.advice}
              </p>
              <p class="mt-2 text-xs leading-relaxed text-muted-foreground/80">
                <span class="font-semibold">Basis:</span> {t.basis}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Cross-links ------------------------------------------------------ -->
    <section class="mt-16 border-t border-border/70 pt-8">
      <p class="text-sm leading-relaxed text-muted-foreground">
        Deciding where to go once you have solved how to get there? The{" "}
        <a href="/free/" class="text-brass hover:underline"
          >free Car Week events list</a
        >{" "}
        is the cheapest way to see cars this week — most of it is street-side and
        needs no ticket, which also means no event parking to pay for. The{" "}
        <a href="/monterey-car-week/schedule/" class="text-brass hover:underline"
          >full schedule</a
        >{" "}
        has every event by day, and the{" "}
        <a href="/monterey-car-week/" class="text-brass hover:underline"
          >Car Week overview</a
        >{" "}
        explains how the week fits together. For the rest of the year, see{" "}
        <a href="/events/" class="text-brass hover:underline"
          >all 2026 Central Coast events</a
        >.
      </p>
    </section>
  </main>
</BaseLayout>
