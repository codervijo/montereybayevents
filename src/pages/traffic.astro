---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ROAD_CLOSURES_URL } from "../data/events";

const site = "https://montereybayevents.com";
const title = "Traffic, Road Closures & Safety — Monterey Car Week 2026";
const description =
  "Live road closures, traffic cameras, public safety text alerts and county permit contacts for Monterey Car Week 2026, August 7–16.";
const canonical = `${site}/traffic/`;

const cards = [
  {
    title: "Live road closures",
    body: "The County of Monterey publishes daily closure and detour information for Highway One, Ocean Avenue, Pacific Grove and the routes into Pebble Beach.",
    cta: { label: "Open county closure map", href: ROAD_CLOSURES_URL },
  },
  {
    title: "Caltrans traffic cameras",
    body: "Caltrans operates live cameras along Highway One and Highway 68. Check them before heading to Laguna Seca or Pebble Beach on peak days.",
    cta: { label: "Caltrans QuickMap", href: "https://quickmap.dot.ca.gov/" },
  },
  {
    title: "Public safety text alerts",
    body: "Text CARWEEK to 65513 to receive public safety messages throughout the week — incidents, closures and emergency notices.",
  },
  {
    title: "County permits",
    body: "For specific county permit information, call the County of Monterey Permit Center at 831-755-5025, or contact the city where the event takes place.",
    cta: { label: "Call 831-755-5025", href: "tel:8317555025" },
  },
];

const tips = [
  "Expect the heaviest congestion Thursday through Sunday, especially mornings on Highway One.",
  "Ocean Avenue in Carmel-by-the-Sea closes for several street concours — park outside downtown and walk.",
  "Laguna Seca gates back up early on race days; arrive before mid-morning or after lunch.",
  "Rideshare and shuttle pickup zones move daily — confirm the location on each event's official page.",
  "Cyclists and pedestrians share the 17-Mile Drive corridor all week. Slow down.",
];
---

<BaseLayout>
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta
      property="og:description"
      content="Road closures, traffic cameras, safety alerts and permit contacts for Monterey Car Week 2026."
    />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Monterey Bay Events" />
    <meta property="og:image" content={`${site}/og-carweek.jpg`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site}/og-carweek.jpg`} />
  </Fragment>

  <main class="mx-auto max-w-6xl px-5 py-14">
    <p class="eyebrow">Plan your movement</p>
    <h1 class="mt-2 text-6xl leading-[0.85] sm:text-8xl">
      Traffic &amp; <span class="text-brass">safety</span>
    </h1>
    <p class="mt-5 max-w-2xl text-base leading-relaxed text-muted-foreground">
      Car Week puts hundreds of thousands of extra vehicles on peninsula roads between
      August 7 and 16. These are the official sources to check before every trip.
    </p>

    <div class="mt-12 grid gap-3 md:grid-cols-2">
      {
        cards.map((c) => (
          <div class="flex flex-col border-l-2 border-border/80 bg-surface/60 px-6 py-6 transition-colors hover:border-brass">
            <h2 class="text-2xl leading-tight">{c.title}</h2>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-muted-foreground">
              {c.body}
            </p>
            {c.cta && (
              <a
                href={c.cta.href}
                target={c.cta.href.startsWith("tel:") ? undefined : "_blank"}
                rel="noreferrer"
                class="mt-5 w-fit border border-brass/60 px-4 py-2 text-[0.65rem] font-bold uppercase tracking-[0.16em] text-brass transition-colors hover:bg-brass hover:text-primary-foreground"
              >
                {c.cta.label}
              </a>
            )}
          </div>
        ))
      }
    </div>

    <section class="mt-16">
      <p class="eyebrow">Local knowledge</p>
      <h2 class="mt-2 text-5xl leading-none">Getting around without the gridlock</h2>
      <ul class="mt-6 divide-y divide-border/70 border-y border-border/70">
        {
          tips.map((t) => (
            <li class="flex gap-4 py-4 text-sm text-muted-foreground">
              <span class="font-display text-lg leading-none text-brass">—</span>
              <span class="leading-relaxed">{t}</span>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</BaseLayout>
