---
// src/pages/events/[month]/ — one hub per month, August–December 2026.
//
// These are the crawlable form of the /events/ month filter: a stable URL per
// month with its own title, its own ItemList and prev/next links, so month-intent
// queries ("santa cruz events october 2026") have a page that answers literally.
import BaseLayout from "../../layouts/BaseLayout.astro";
import { isPastDate } from "../../lib/isPast";
import {
  DATE_TBA,
  MONTHS,
  adjacentMonths,
  eventHref,
  eventsInMonth,
  monthHref,
  monthTitle,
  type MonthKey,
  type RegionalEvent,
} from "../../data/events-2026";
import { buildItemListJsonLd } from "../../lib/regionalEventSchema";

export function getStaticPaths() {
  return MONTHS.map((m) => ({
    params: { month: m.key },
    props: { monthKey: m.key, label: m.label },
  }));
}

const { monthKey, label } = Astro.props as { monthKey: MonthKey; label: string };

const site = "https://montereybayevents.com";
const events = eventsInMonth(monthKey);
// Laguna Seca runs several events a year; the camping and access guide is
// relevant to whichever month carries one, rather than hard-coded to September.
const hasLagunaSeca = events.some(
  (e) =>
    (e.venue ?? e.cityText).includes("Laguna Seca") &&
    !isPastDate(e.start, e.end),
);
const { prev, next } = adjacentMonths(monthKey);

const monterey = events.filter((e) => e.county === "Monterey");
const santaCruz = events.filter((e) => e.county === "Santa Cruz");

const title = monthTitle(monthKey);
const description = `Every public event in Monterey and Santa Cruz counties in ${label}: ${events.length} listings with dates, cities and official links — ${monterey.length} in Monterey County, ${santaCruz.length} in Santa Cruz County.`;
const canonical = `${site}${monthHref(monthKey)}`;
const image = `${site}/og-carweek.jpg`;

const jsonLd = buildItemListJsonLd(
  events,
  site,
  eventHref,
  `Central Coast events in ${label}`,
);

const dateLabel = (e: RegionalEvent) => e.dateText || DATE_TBA;
---

<BaseLayout>
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="description" content={description.slice(0, 155)} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description.slice(0, 200)} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Monterey Bay Events" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={image} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description.slice(0, 200)} />
    <meta name="twitter:image" content={image} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  </Fragment>

  <main class="mx-auto max-w-4xl px-5 py-14">
    <a
      href="/events/"
      class="text-[0.65rem] font-bold uppercase tracking-[0.2em] text-muted-foreground hover:text-brass"
    >
      ← All 2026 events
    </a>

    <p class="eyebrow mt-6">Monterey &amp; Santa Cruz counties</p>
    <h1 class="mt-2 text-5xl leading-[0.88] sm:text-7xl">
      Central Coast events in
      <br />
      <span class="text-brass">{label}</span>
    </h1>
    <p class="mt-6 max-w-2xl text-base leading-relaxed text-muted-foreground">
      {events.length} public {events.length === 1 ? "event" : "events"} across both
      counties in {label} — {monterey.length} in Monterey County, {santaCruz.length}
      {" "}in Santa Cruz County. Dates are the organizer's; check the official page
      before you travel.
    </p>

    <div class="mt-12 grid gap-3">
      {
        events.map((e) => (
          <article class="border-l-2 border-border/80 bg-surface/60 px-5 py-4 transition-colors hover:border-brass">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <h2 class="text-xl leading-tight">
                <a href={eventHref(e)} class="text-foreground transition-colors hover:text-brass">
                  {e.name}
                </a>
              </h2>
              <span
                class={`text-[0.65rem] font-semibold uppercase tracking-[0.18em] ${
                  e.start ? "text-brass" : "text-muted-foreground"
                }`}
              >
                {dateLabel(e)}
              </span>
            </div>

            <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.65rem] uppercase tracking-[0.14em] text-muted-foreground">
              <span>{e.city ?? "Countywide"}</span>
              <span aria-hidden="true">·</span>
              <span>{e.county} County</span>
              <span aria-hidden="true">·</span>
              <span>{e.category}</span>
            </div>

            {e.description && (
              <p class="mt-2 max-w-3xl text-sm leading-relaxed text-muted-foreground">
                {e.description}
              </p>
            )}

            {e.officialWebsite && (
              <a
                href={e.officialWebsite}
                target="_blank"
                rel="noreferrer"
                class="mt-3 inline-block text-[0.65rem] font-bold uppercase tracking-[0.16em] text-brass hover:underline"
              >
                Official site ↗
              </a>
            )}
          </article>
        ))
      }
    </div>

    <nav
      class="mt-16 flex flex-wrap items-center justify-between gap-4 border-t border-border/70 pt-8"
      aria-label="Nearby months"
    >
      {
        prev ? (
          <a
            href={monthHref(prev.key)}
            rel="prev"
            class="border border-border px-5 py-3 text-[0.65rem] font-bold uppercase tracking-[0.16em] text-muted-foreground transition-colors hover:border-brass hover:text-brass"
          >
            ← {prev.label}
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a
            href={monthHref(next.key)}
            rel="next"
            class="border border-border px-5 py-3 text-[0.65rem] font-bold uppercase tracking-[0.16em] text-muted-foreground transition-colors hover:border-brass hover:text-brass"
          >
            {next.label} →
          </a>
        ) : (
          <span />
        )
      }
    </nav>

    <p class="mt-8 text-sm leading-relaxed text-muted-foreground">
      Every month, August through December 2026:{" "}
      {
        MONTHS.map((m, i) => (
          <>
            {i > 0 ? " · " : ""}
            {m.key === monthKey ? (
              <span class="text-foreground">{m.label}</span>
            ) : (
              <a href={monthHref(m.key)} class="text-brass hover:underline">
                {m.label}
              </a>
            )}
          </>
        ))
      }
    </p>

    {
      hasLagunaSeca && (
        <a
          href="/laguna-seca/camping/"
          class="mt-10 block border-l-2 border-brass bg-surface/60 px-6 py-6 transition-colors hover:bg-surface"
        >
          <p class="text-[0.6rem] font-bold uppercase tracking-[0.2em] text-muted-foreground">
            Racing at Laguna Seca this month
          </p>
          <p class="mt-2 text-2xl leading-tight text-brass">
            Camping at Laguna Seca →
          </p>
          <p class="mt-2 text-base leading-relaxed text-muted-foreground">
            All ten camping areas, which entrance to use, the 40-foot RV limit —
            and the camping and parking prices the raceway does not publish.
          </p>
        </a>
      )
    }
  </main>
</BaseLayout>
