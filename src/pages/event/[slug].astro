---
// Static per-event detail pages. TanStack's loader + notFound() becomes
// getStaticPaths(): every slug in the event index is pre-rendered at build.
//
// Two datasets share this route, and their slugs are disjoint:
//   - Monterey Car Week 2026 (src/data/events.ts) — rendered inline below.
//   - the regional Aug–Dec 2026 calendar (src/data/events-2026.ts) — rendered by
//     RegionalEventPage.astro, which knows a county/city/date-range rather than
//     a per-day admission schedule.
// A row in the regional CSV that IS a Car Week event carries `existingSlug` and
// builds no page here; it links to the Car Week page that already exists, so no
// live /event/ URL moves and no two pages compete for the same event.
import BaseLayout from "../../layouts/BaseLayout.astro";
import RegionalEventPage from "../../components/RegionalEventPage.astro";
import { allEventDetails, mapUrl, type EventDetail } from "../../data/eventIndex";
import { ROAD_CLOSURES_URL } from "../../data/events";
import { regionalEventPages, type RegionalEvent } from "../../data/events-2026";
import { buildEventJsonLd, formatTime } from "../../lib/eventSchema";

export function getStaticPaths() {
  return [
    ...allEventDetails.map((event) => ({
      params: { slug: event.slug },
      props: { event, regional: undefined },
    })),
    ...regionalEventPages.map((regional) => ({
      params: { slug: regional.slug },
      props: { event: undefined, regional },
    })),
  ];
}

const { event, regional } = Astro.props as {
  event?: EventDetail;
  regional?: RegionalEvent;
};

const site = "https://montereybayevents.com";
const dates = event ? event.days.map((d) => d.short).join(", ") : "";
const fullDescription = event
  ? (event.description ??
    `${event.title} during Monterey Car Week 2026 — ${dates}. ${event.accessLabel}${
      event.venue ? ` at ${event.venue.venue}.` : "."
    }`)
  : "";
const title = event ? `${event.title} — Monterey Car Week 2026` : "";
const canonical = event ? `${site}/event/${event.slug}/` : "";
const image = `${site}/og-carweek.jpg`;
const desc = fullDescription.slice(0, 155);
const keywords = event
  ? [
      event.title,
      "Monterey Car Week 2026",
      event.venue?.venue,
      event.accessLabel,
      "Monterey Bay events",
    ]
      .filter(Boolean)
      .join(", ")
  : "";

// Event JSON-LD, incl. the required startDate — built in src/lib/eventSchema.ts
// so it can be unit-tested against every event in the dataset.
const jsonLd = event ? buildEventJsonLd(event, site) : null;

const accessStyles = {
  free: "border-brass/60 text-brass",
  ticketed: "border-border text-foreground",
  private: "border-border/60 text-muted-foreground",
} as const;

const others = event
  ? allEventDetails
      .filter((e) => e.slug !== event.slug && e.days[0]?.id === event.days[0]?.id)
      .slice(0, 6)
  : [];
---

{!event && regional && <RegionalEventPage event={regional} />}

{event && (
<BaseLayout>
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="description" content={desc} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Monterey Bay Events" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={image} />
    <!-- Real dimensions of public/og-carweek.jpg, verified with a JPEG SOF
         read. The TanStack source declared 1536x1024, which the file is not. -->
    <meta property="og:image:width" content="1920" />
    <meta property="og:image:height" content="1088" />
    <meta property="og:image:alt" content={`${event.title} — Monterey Car Week 2026`} />
    <meta property="article:section" content="Monterey Car Week 2026" />
    {
      event.days.map((d) => (
        <meta property="article:tag" content={`${d.weekday} ${d.date}`} />
      ))
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={`${event.title} — Monterey Car Week 2026`} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  </Fragment>

  <main class="mx-auto max-w-4xl px-5 py-14">
    <a
      href="/monterey-car-week/schedule/"
      class="text-[0.65rem] font-bold uppercase tracking-[0.2em] text-muted-foreground hover:text-brass"
    >
      ← Full schedule
    </a>

    <p class="eyebrow mt-6">
      {event.days.map((d) => `${d.weekday} ${d.date}`).join(" · ")}
    </p>
    <h1 class="mt-2 text-5xl leading-[0.88] sm:text-7xl">{event.title}</h1>

    <div class="mt-5 flex flex-wrap items-center gap-3">
      <span
        class={`border px-3 py-1 text-[0.6rem] font-semibold uppercase tracking-[0.16em] ${accessStyles[event.access]}`}
      >
        {event.accessLabel}
      </span>
      <span class="text-xs uppercase tracking-[0.16em] text-muted-foreground">
        {event.days.length} {event.days.length === 1 ? "day" : "days"}
      </span>
    </div>

    {
      event.description && (
        <p class="mt-8 max-w-2xl text-lg leading-relaxed text-muted-foreground">
          {event.description}
        </p>
      )
    }

    <!-- Contextual cross-links. The wording changes with admission because the
         reader's next question changes with it: a free event's visitor wants the
         rest of the free list, a ticketed one's may be looking for an
         alternative that costs nothing. Both want to know about parking. -->
    <p class="mt-6 max-w-2xl text-sm leading-relaxed text-muted-foreground">
      {
        event.access === "free" ? (
          <Fragment>
            This is one of the{" "}
            <a href="/free/" class="text-brass hover:underline">
              free Car Week events
            </a>{" "}
            — that list has every no-ticket listing across the ten days, with the
            admission claim checked against each organizer's own page.
          </Fragment>
        ) : event.access === "ticketed" ? (
          <Fragment>
            This one is ticketed. If you would rather not pay, the{" "}
            <a href="/free/" class="text-brass hover:underline">
              free Car Week events list
            </a>{" "}
            covers everything across the week that costs nothing to watch.
          </Fragment>
        ) : (
          <Fragment>
            This is a private event and not open to spectators. The{" "}
            <a href="/free/" class="text-brass hover:underline">
              free Car Week events list
            </a>{" "}
            covers what you can actually walk up to across the ten days.
          </Fragment>
        )
      }{" "}
      Before you set off, the{" "}
      <a href="/traffic/" class="text-brass hover:underline">
        traffic and parking guide
      </a>{" "}
      has closures by day and where to park at each venue.
    </p>

    <div class="mt-12 grid gap-10 sm:grid-cols-2">
      <section>
        <h2 class="border-b border-border/70 pb-2 text-2xl text-brass">When</h2>
        <ul class="mt-4 space-y-2">
          {
            event.days.map((d) => (
              <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <a
                  href={`/monterey-car-week/schedule/#${d.id}`}
                  class="text-base text-foreground hover:text-brass"
                >
                  {d.weekday}, {d.date}
                </a>
                {d.startTime && (
                  <span class="text-sm text-brass">
                    {formatTime(d.startTime)}
                    {d.endTime ? ` – ${formatTime(d.endTime)}` : ""}
                  </span>
                )}
                {d.label && (
                  <span class="text-[0.6rem] font-semibold uppercase tracking-[0.18em] text-muted-foreground">
                    {d.label}
                  </span>
                )}
              </li>
            ))
          }
        </ul>
        <p class="mt-4 text-sm leading-relaxed text-muted-foreground">
          {
            event.days.some((d) => d.startTime)
              ? "Times are the organizer's published hours and can shift — confirm on the official page before you travel."
              : "We don't have a confirmed start time for this one yet. Check the official page before you travel."
          }
        </p>
      </section>

      <section>
        <h2 class="border-b border-border/70 pb-2 text-2xl text-brass">Where</h2>
        {
          event.venue ? (
            <div class="mt-4">
              <p class="text-base text-foreground">{event.venue.venue}</p>
              <p class="mt-1 text-sm leading-relaxed text-muted-foreground">
                {event.venue.address}
              </p>
              <a
                href={mapUrl(event.venue)}
                target="_blank"
                rel="noreferrer"
                class="mt-4 inline-block border border-border px-4 py-2 text-[0.65rem] font-bold uppercase tracking-[0.16em] text-muted-foreground transition-colors hover:border-brass hover:text-brass"
              >
                Open in maps ↗
              </a>
            </div>
          ) : (
            <p class="mt-4 text-sm leading-relaxed text-muted-foreground">
              Location is released to attendees by the organizer.
            </p>
          )
        }
        <p class="mt-5 text-sm leading-relaxed text-muted-foreground">
          Peninsula traffic peaks mid-week —{" "}
          <a href="/traffic/" class="text-brass hover:underline">
            check closures, parking and shuttles for this venue
          </a>{" "}
          or the{" "}
          <a
            href={ROAD_CLOSURES_URL}
            target="_blank"
            rel="noreferrer"
            class="text-brass hover:underline"
          >
            county closure list
          </a>
          .
        </p>
      </section>
    </div>

    {
      event.url && (
        <a
          href={event.url}
          target="_blank"
          rel="noreferrer"
          class="mt-12 inline-block border border-brass bg-brass px-6 py-3 text-xs font-bold uppercase tracking-[0.18em] text-primary-foreground transition-opacity hover:opacity-85"
        >
          Official event page ↗
        </a>
      )
    }

    {
      others.length > 0 && (
        <section class="mt-16 border-t border-border/70 pt-8">
          <h2 class="text-2xl text-brass">Also on {event.days[0]?.date}</h2>
          <div class="mt-4 grid gap-2 sm:grid-cols-2">
            {others.map((o) => (
              <a
                href={`/event/${o.slug}/`}
                class="border-l-2 border-border/80 bg-surface/60 px-4 py-3 text-sm text-foreground transition-colors hover:border-brass hover:text-brass"
              >
                {o.title}
              </a>
            ))}
          </div>
        </section>
      )
    }

    <a
      href="/events/"
      class="mt-10 inline-block text-[0.65rem] font-bold uppercase tracking-[0.2em] text-muted-foreground hover:text-brass"
    >
      All 2026 Central Coast events →
    </a>
  </main>
</BaseLayout>
)}
